#!/usr/bin/env bash
# dsh-romeo: DeepSeek Harness (dsh) on your computer, DeepSeek-V4.1-Flash-1017 or Kimi-K3.1-Pro on ROMEO's GPUs.
#
# Every day
#   dsh-romeo --launch            start the model on ROMEO, wait until it answers, open dsh
#   dsh-romeo                     open dsh on the model job already running
#   dsh-romeo --status            what runs on ROMEO, and why the last job ended
#   dsh-romeo --stop              stop the model jobs (they use GPU hours) and the tunnel
#
# Options (before the command, in any order; --models, --voice and --web are remembered)
#   --models deepseek|kimi|kimi+deepseek   the model; kimi+deepseek: DeepSeek runs the subagents
#   --voice on|off                voice input in dsh, Whisper on ROMEO (1 GPU)
#   --web on|off                  web search in dsh, RustXNG on the ROMEO login node (no GPU)
#   --launch N                    N DeepSeek jobs at once (1-8), for many agents
#
# Other ways in
#   dsh-romeo --desktop           the DeepSeek Harness desktop app (macOS) instead of the Web UI
#   dsh-romeo headless "a task"   one task, the answer on stdout; any dsh profile: web --port 3000
#   dsh-romeo --run CMD [ARGS]    opencode, codex, claude, aider, python... on the ROMEO model
#   dsh-romeo --serve             only the tunnel, then print the endpoint; --env: as variables
#
# When something is wrong
#   dsh-romeo --doctor            check this computer, SSH, ROMEO, the fiches and the key
#   dsh-romeo --logs [-f]         the model job's log (-f: follow it, Ctrl-C to quit)
#   dsh-romeo --setup             copy the fiches to ROMEO again (--launch does it when they changed)
#
#   --completion bash|zsh   -V, --version   -h, --help
#
# What it does: keeps the romeollmtool gateway running on the ROMEO login node, launches the
# model with romeollmtool when asked, opens one SSH connection that carries a tunnel
# 127.0.0.1:$DSH_ROMEO_PORT -> gateway, then runs dsh with an overlay (--patch) that adds a
# "romeo" provider and makes it the default model. Your own dsh profiles are not modified.
#
# Settings: ~/.config/dsh-romeo/config (written by install.sh). A variable set in the
# environment wins over the file.
set -euo pipefail

VERSION=0.1.0

# The repository this script lives in (it is usually reached through a symlink).
src=$0
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
ROOT=$(cd "$(dirname "$src")/.." && pwd)

CONFIG_DIR=${DSH_ROMEO_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dsh-romeo}
MODELS_ENV=${DSH_ROMEO_MODELS:-}  # set in the environment: wins over the remembered --models
VOICE_ENV=${DSH_ROMEO_VOICE:-}
WEB_ENV=${DSH_ROMEO_WEB:-}
# shellcheck source=/dev/null
[ -f "$CONFIG_DIR/config" ] && . "$CONFIG_DIR/config"
# The last --models, kept until the next one; then the environment, the config file, deepseek.
MODELS_FILE=$CONFIG_DIR/models
# A remembered value this version does not know (an older or edited file) is dropped, not fatal:
# it would block every command, --stop included.
if [ -z "$MODELS_ENV" ] && [ -s "$MODELS_FILE" ]; then
  case $(cat "$MODELS_FILE") in
    deepseek | kimi | kimi+deepseek) DSH_ROMEO_MODELS=$(cat "$MODELS_FILE") ;;
    *) printf 'dsh-romeo: remembered --models %s is not valid: forgotten\n' "$(cat "$MODELS_FILE")" >&2; rm -f "$MODELS_FILE" ;;
  esac
fi
WEB_FILE=$CONFIG_DIR/web
if [ -z "$WEB_ENV" ] && [ -s "$WEB_FILE" ]; then
  case $(cat "$WEB_FILE") in
    on | off) DSH_ROMEO_WEB=$(cat "$WEB_FILE") ;;
    *) rm -f "$WEB_FILE" ;;
  esac
fi
VOICE_FILE=$CONFIG_DIR/voice
if [ -z "$VOICE_ENV" ] && [ -s "$VOICE_FILE" ]; then
  case $(cat "$VOICE_FILE") in
    on | off) DSH_ROMEO_VOICE=$(cat "$VOICE_FILE") ;;
    *) rm -f "$VOICE_FILE" ;;
  esac
fi
: "${ROMEO_SSH_HOST:=romeo}"                             # ssh alias of a ROMEO login node
: "${ROMEO_PROJECT:=}"                                   # Slurm project code charged for the model jobs
: "${DSH_ROMEO_MODELS:=deepseek}"                        # deepseek, kimi, or kimi+deepseek (DeepSeek subagents)
: "${DSH_ROMEO_VOICE:=off}"                              # on: voice input, Whisper on ROMEO (1 GPU)
: "${DSH_ROMEO_WEB:=off}"                                # on: web search, RustXNG on the ROMEO login node
: "${DSH_ROMEO_FICHE:=}"                                 # a fiche of your own for the agent's model
: "${DSH_ROMEO_TIME:=08:00:00}"                          # model job duration (max 24:00:00)
: "${DSH_ROMEO_PORT:=11318}"                             # local end of the tunnel
: "${DSH_ROMEO_VOICE_PORT:=11319}"                       # local end of the tunnel to the Whisper job
: "${DSH_ROMEO_EFFORT:=max}"                             # default reasoning effort: off, low, high, max
: "${DSH_ROMEO_SEARXNG_URL:=}"                           # SearXNG for web search, e.g. http://127.0.0.1:8888
: "${DSH_ROMEO_GATEWAY:=standard}"                       # standard, or fast: no 100-stream cap, affinity
: "${DSH_ROMEO_FAST_PORT:=11320}"                        # port of the fast gateway on the login node
: "${DSH_ROMEO_FAST_PROCS:=4}"                           # its processes
: "${ROMEOLLMTOOL:=/apps/romeotools/romeollmtool/romeollmtool}"

HOST=$ROMEO_SSH_HOST
FICHE_DEEPSEEK=dsh-deepseek-v4.1-flash-1017-1m
FICHE_KIMI=dsh-kimi-k3.1-pro-1m
FICHE_VOICE=dsh-whisper-large-v3-turbo
PORT=$DSH_ROMEO_PORT
# Control socket of the shared SSH connection (Unix socket paths are limited to ~100 bytes).
CTL=${DSH_ROMEO_SOCKET:-$HOME/.ssh/dsh-romeo-$HOST.sock}
OVERLAY=$CONFIG_DIR/dsh.patch.yml
DSH=${DSH_ROMEO_DSH:-dsh}
PROFILES=${DSH_HOME:-$HOME/.dsh}/profiles

# Messages go to stderr: stdout is left to what a command prints (--env, --serve) and to the client.
# Colors on a terminal only, never with NO_COLOR (https://no-color.org) or TERM=dumb.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  B=$'\e[1m' D=$'\e[2m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'
else B='' D='' G='' Y='' R='' N=''; fi
say() { printf '%s\n' "${B}dsh-romeo${N} $*" >&2; }
note() { printf '%s\n' "          ${D}$*${N}" >&2; }
PROGRESS='' SUBMITTED=''  # a waiting line being rewritten in place; the jobs this run submitted
die() {  # die "what went wrong" ["the command to type next"]
  [ -z "$PROGRESS" ] || printf '\r\033[K' >&2
  printf '%s\n' "${R}dsh-romeo:${N} $1" >&2
  [ $# -lt 2 ] || printf '%s\n' "          next: ${B}$2${N}" >&2
  [ -z "$SUBMITTED" ] || note "model job$SUBMITTED stays on ROMEO and uses GPU hours: dsh-romeo --stop"
  exit 1
}
# dsh's effort levels; "none" is only what the API receives for "off".
case $DSH_ROMEO_EFFORT in
  none) DSH_ROMEO_EFFORT=off ;;
  off | low | high | max) ;;
  *) die "DSH_ROMEO_EFFORT: off, low, high or max, not '$DSH_ROMEO_EFFORT'" ;;
esac

usage() {  # the header comment, up to "What it does", and the remembered choices
  local b='' n=''
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then b=$'\e[1m' n=$'\e[0m'; fi
  awk -v b="$b" -v n="$n" 'NR > 1 && /^# What it does/ { exit } NR > 1 { sub(/^# ?/, ""); if (/^[A-Z]/ && NR > 3) $0 = b $0 n; print }' "$src"
  printf '  now: --models %s --voice %s --web %s%s\n' "$DSH_ROMEO_MODELS" "$DSH_ROMEO_VOICE" "$DSH_ROMEO_WEB" \
    "$([ -n "$ROMEO_PROJECT" ] && echo ", project $ROMEO_PROJECT" || echo ", no project (rerun install.sh)")"
}

# FICHE: the agent's model; SUB_FICHE: its subagents' model, empty when they use the same one.
resolve_models() {
  case $DSH_ROMEO_MODELS in
    deepseek) FICHE=$FICHE_DEEPSEEK SUB_FICHE='' ;;
    kimi) FICHE=$FICHE_KIMI SUB_FICHE='' ;;
    kimi+deepseek) FICHE=$FICHE_KIMI SUB_FICHE=$FICHE_DEEPSEEK ;;
    *) die "models: deepseek, kimi or kimi+deepseek, not '$DSH_ROMEO_MODELS'" "dsh-romeo --models deepseek" ;;
  esac
  # The DeepSeek fiche was the DSH_ROMEO_FICHE default before the choice of models.
  case $DSH_ROMEO_FICHE in '' | "$FICHE_DEEPSEEK") ;; *) FICHE=$DSH_ROMEO_FICHE ;; esac
  case $DSH_ROMEO_VOICE in
    on) VOICE_FICHE=$FICHE_VOICE ;;
    off) VOICE_FICHE='' ;;
    *) die "voice: on or off, not '$DSH_ROMEO_VOICE'" "dsh-romeo --voice off" ;;
  esac
  case $DSH_ROMEO_WEB in
    on | off) ;;
    *) die "web: on or off, not '$DSH_ROMEO_WEB'" "dsh-romeo --web off" ;;
  esac
  FICHES=$FICHE${SUB_FICHE:+ $SUB_FICHE}${VOICE_FICHE:+ $VOICE_FICHE}
}

# ---------------------------------------------------------------- SSH

# OpenSSH 10 warns about every server without post-quantum key exchange: noise here.
quiet() { grep -v -E 'post-quantum|store now, decrypt later|openssh.com/pq|^\*\* ' >&2 || true; }

connect() {  # one connection, reused by every command and carrying the tunnel
  (umask 077; mkdir -p "$(dirname "$CTL")")
  if mux check; then
    alive && return 0
    # After a sleep or a network change the master still runs but nothing goes through it.
    say "${Y}the SSH connection to $HOST no longer answers${N} ${D}(sleep or network change): a new one${N}"
    mux exit || true
    rm -f "$CTL.target" "$CTL.voice"
  fi
  # Two starts at once (the Web UI and --desktop): one opens the connection, the other waits for it.
  local _
  for _ in $(seq 1 60); do
    mkdir "$CTL.lock" 2>/dev/null && break
    mux check && return 0
    sleep 0.5
  done
  if mux check; then rmdir "$CTL.lock" 2>/dev/null || true; return 0; fi
  rm -f "$CTL"
  # ssh's messages to a file, not a pipe: the master stays in the background and keeps it open.
  ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30 -o ServerAliveCountMax=4 \
      -o ExitOnForwardFailure=yes -M -S "$CTL" -f -N "$HOST" 2>"$CTL.log" && { rmdir "$CTL.lock" 2>/dev/null || true; return 0; }
  rmdir "$CTL.lock" 2>/dev/null || true
  local why
  why=$(quiet <"$CTL.log" 2>&1 | tail -1)
  case $why in
    *'Permission denied'* | *'Host key verification'*)
      die "cannot connect to '$HOST' over SSH: $why" "ssh $HOST hostname   (it must work without a password: README, Install)" ;;
    *) die "cannot connect to '$HOST' over SSH: ${why:-ssh gave no reason}" "ssh $HOST hostname   (network or VPN down?)" ;;
  esac
}

alive() {  # a round trip through the shared connection within 10 s
  local pid _
  ssh -n -S "$CTL" -o BatchMode=yes "$HOST" true >/dev/null 2>&1 &
  pid=$!
  for _ in $(seq 1 50); do
    kill -0 "$pid" 2>/dev/null || { wait "$pid"; return; }
    sleep 0.2
  done
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 1
}

lost() {  # $1: ssh's exit status. 255: the connection, not the command, failed
  [ "$1" -ne 255 ] || die "lost the SSH connection to '$HOST' (sleep or network change?): nothing was changed on ROMEO" "dsh-romeo again"
}

rsh() { ssh -n -S "$CTL" -o BatchMode=yes "$HOST" "$@" 2> >(quiet); }      # stdin stays yours
rsh_stdin() { ssh -S "$CTL" -o BatchMode=yes "$HOST" "$@" 2> >(quiet); }   # stdin goes to ROMEO

disconnect() { mux exit || true; }

mux() { ssh -S "$CTL" -O "$@" "$HOST" 2>/dev/null; }  # an operation on the shared connection

forward() {  # $1 local port, $2 host:port, $3 file noting the forward: replaces the one noted there
  local previous
  previous=$(cat "$3" 2>/dev/null || true)
  [ -z "$previous" ] || mux cancel -L "$1:$previous" || true
  mux cancel -L "$1:$2" || true
  # ssh's own reason in FORWARD_ERROR when it refuses: a busy port is only one of them.
  FORWARD_ERROR=$(ssh -S "$CTL" -O forward -L "$1:$2" "$HOST" 2>&1 >/dev/null) || return 1
  printf '%s\n' "$2" >"$3"
}

port_holder() {  # the program listening on local port $1 ("name pid"), empty when none or no lsof
  command -v lsof >/dev/null || return 0
  { lsof -nP -iTCP:"$1" -sTCP:LISTEN -Fcp 2>/dev/null || true; } | awk '/^p/ { pid = substr($0, 2) } /^c/ { print substr($0, 2), pid; exit }'
}

# ---------------------------------------------------------------- ROMEO

rlt() { local q; q=$(printf ' %q' "$@"); rsh "$ROMEOLLMTOOL$q"; }  # arguments with spaces stay whole

gateway_url() {  # the gateway's URL, empty when it is not running; dies when ROMEO cannot be reached
  local out rc=0
  out=$(rlt gateway status 2>/dev/null) || rc=$?
  lost "$rc"
  printf '%s\n' "$out" | grep -oE 'https?://[^ ]+:[0-9]+/v1' | head -1 || true
}

ensure_gateway() {
  local url
  url=$(gateway_url)
  if [ -z "$url" ]; then
    say "starting the romeollmtool gateway on ROMEO"
    local out
    out=$(rlt gateway start --hours 24 2>&1) \
      || die "romeollmtool's gateway did not start: $(printf '%s\n' "$out" | tail -1)" "ssh $HOST $ROMEOLLMTOOL doctor"
    url=$(gateway_url)
    [ -n "$url" ] || die "romeollmtool's gateway did not start" "ssh $HOST $ROMEOLLMTOOL gateway logs"
  else
    # Its automatic stop would also cancel the model jobs: push it 24 h away.
    rlt gateway extend --hours 24 >/dev/null 2>&1 || true
  fi
  GATEWAY=$url
}

# A fiche as romeollmtool will launch it: served model name, context and output limits, inputs
# (images unless --language-model-only), in MODEL CONTEXT MAX_TOKENS INPUT LABEL, or SUB_MODEL...
# with $2 = SUB_.
read_fiche() {
  local fiche=$1 p=${2:-} show
  show=$(rlt catalog show "$fiche" 2>/dev/null) || true
  printf '%s\n' "$show" | grep -q '^vllm:' \
    || die "fiche '$fiche' not found on ROMEO" "dsh-romeo --setup"
  eval "$(printf '%s\n' "$show" | awk -v p="$p" '
    /^vllm:/ { v = 1; next }
    /^generation:/ { g = 1; next }
    /^[^ -]/ { v = 0; g = 0 }
    v && /^  served_model_name:/ { served = $2 }
    v && /^  model:/ { model = $2; gsub(/["\047]/, "", model) }
    v && /--max-model-len/ { getline; gsub(/[^0-9]/, ""); ctx = $0 }
    v && /--language-model-only/ { textonly = 1 }
    g && /^  max_tokens:/ { out = $2 }
    END {
      name = served != "" ? served : model
      gsub(/["\047]/, "", name); gsub(/["\047]/, "", out)
      printf "%sMODEL=%s %sCONTEXT=%s %sMAX_TOKENS=%s %sINPUT=%s %sWEIGHTS=%s\n", p, name, p, ctx + 0 ? ctx : 262144, p, out + 0 ? out : 65536, p, textonly ? "text" : "text,image", p, model
    }')"
  local model=${p}MODEL
  [ -n "${!model}" ] || die "cannot read the served model name of fiche '$fiche'"
  printf -v "${p}LABEL" %s "$(label_of "${!model}")"
}

label_of() {  # the model's name in the clients
  case $1 in
    *kimi-k3.1*) echo Kimi-K3.1-Pro ;;
    *whisper*) echo Whisper-large-v3-turbo ;;
    *) echo DeepSeek-V4.1-Flash-1017 ;;
  esac
}

read_fiches() {
  read_fiche "$FICHE"
  SUB_MODEL='' SUB_LABEL='' VOICE_MODEL=''
  [ -z "$SUB_FICHE" ] || read_fiche "$SUB_FICHE" SUB_
  [ -z "$VOICE_FICHE" ] || read_fiche "$VOICE_FICHE" VOICE_
}

jobs_of_fiche() {  # "jobid state elapsed left nodes start reason" for each model job of fiche $1
  # The reason last: it can hold spaces. start: Slurm's estimate for a pending job, or N/A.
  # Empty means no job, never "ROMEO did not answer": --stop and --launch act on it.
  local out rc=0
  out=$(rsh "squeue -u \$USER -h -n $(printf %q "romeollmtool-$1") -o '%i %T %M %L %D %S %r'") || rc=$?
  lost "$rc"
  [ "$rc" = 0 ] || return "$rc"   # unknown is not "no job"
  printf '%s\n' "$out" | grep -E '^[0-9]' || true  # not what a login script prints
}

jobs_known() {  # $1 a fiche: its jobs in JOBS; dies when they cannot be listed
  JOBS=$(jobs_of_fiche "$1") || die "squeue did not answer on ROMEO: the jobs of $1 are unknown" "dsh-romeo --status"
}

queue_eta() {  # $1: squeue's %S, $2: its %r. ", starts ~14:32 (Resources)", with the day when not today
  local day=${1%T*} hm=${1#*T} out=''
  case $1 in
    *T*) hm=${hm%:*}
         if [ "$day" = "$(date +%Y-%m-%d)" ]; then out=", starts ~$hm"; else out=", starts ~${day#*-} $hm"; fi ;;
  esac
  case ${2:-None} in None) ;; *) out="$out ($(reason_text "$2"))" ;; esac
  printf '%s' "$out"
}

reason_text() {  # squeue's %r, in words
  case $1 in
    Resources) echo "no free GPU nodes yet" ;;
    Priority) echo "other jobs go first" ;;
    *GRESMinutes* | *GRESRunMinutes*) echo "the project's GPU hours are used up" ;;
    AssocGrpGRES* | QOSGrpGRES* | AssocGrpNodeLimit* | QOSGrpNodeLimit*) echo "the project's GPU limit is reached: its other jobs hold them" ;;
    ReqNodeNotAvail* | Reservation* | PartitionDown | PartitionInactive) echo "nodes reserved or down: maintenance?" ;;
    *Held*) echo "held" ;;
    PartitionTimeLimit | QOSMaxWallDurationPerJobLimit | AssocMaxWallDurationPerJobLimit) echo "its time limit is over the allowed one" ;;
    *) echo "$1" ;;
  esac
}

# A pending job that will never start by waiting: dies with what to do. $1: jobs_of_fiche's lines.
check_blocked() {
  local id st el left nodes start reason
  while read -r id st el left nodes start reason; do
    [ "$st" = PENDING ] || continue
    case $reason in
      *GRESMinutes* | *GRESRunMinutes*)
        die "job $id cannot start: project $ROMEO_PROJECT has used up its GPU hours ($reason)" "dsh-romeo --stop   (then ask ROMEO support, or install.sh --project another one)" ;;
      PartitionTimeLimit | QOSMaxWallDurationPerJobLimit | AssocMaxWallDurationPerJobLimit)
        die "job $id cannot start: DSH_ROMEO_TIME=$DSH_ROMEO_TIME is over the allowed time ($reason)" "dsh-romeo --stop, then DSH_ROMEO_TIME=08:00:00 dsh-romeo --launch" ;;
      *Held*)
        die "job $id is held by Slurm ($reason)" "ssh $HOST scontrol release $id   (or dsh-romeo --stop)" ;;
    esac
  done <<<"$1"
}

minutes_of() {  # a Slurm duration ([D-]H:MM:SS, MM:SS) in minutes; 0 when unreadable
  local t=$1 d=0 a b c
  case $t in *-*) d=${t%%-*}; t=${t#*-} ;; esac
  IFS=: read -r a b c <<<"$t"
  case "$d$a${b:-}${c:-}" in *[!0-9]*) echo 0; return ;; esac
  if [ -n "${c:-}" ]; then echo $((10#$d * 1440 + 10#$a * 60 + 10#$b))
  elif [ -n "${b:-}" ]; then echo $((10#$d * 1440 + 10#$a))
  else echo $((10#$d * 1440)); fi
}

running_job() { awk '$2 == "RUNNING" { print $1; exit }'; }  # stdin: jobs_of_fiche's lines

jobs_of_fiches() {  # for the waiting line only: squeue's own errors would break it
  local f
  for f in $FICHES; do jobs_of_fiche "$f" 2>/dev/null || true; done
}

launch_jobs() {  # $1 jobs of the agent's model, one of the subagents' and one of Whisper if they have none
  local n=$1
  [ -n "$ROMEO_PROJECT" ] || die "no project code (ROMEO_PROJECT in $CONFIG_DIR/config)" "$ROOT/install.sh --project r123456"
  # Slurm would keep a job over 24 h in the queue for ever, and take a typo for minutes.
  [[ $DSH_ROMEO_TIME =~ ^([0-9]{1,2}):([0-5][0-9]):([0-5][0-9])$ ]] && [ $((10#${BASH_REMATCH[1]} * 3600 + 10#${BASH_REMATCH[2]} * 60 + 10#${BASH_REMATCH[3]})) -le 86400 ] \
    && [ "$DSH_ROMEO_TIME" != 0:00:00 ] && [ "$DSH_ROMEO_TIME" != 00:00:00 ] \
    || die "DSH_ROMEO_TIME: HH:MM:SS up to 24:00:00, not '$DSH_ROMEO_TIME'" "DSH_ROMEO_TIME=08:00:00 dsh-romeo --launch"
  # 32 GPUs per Kimi job, 60 per account: a second one would wait forever.
  [ "$LABEL" != Kimi-K3.1-Pro ] || [ "$n" -eq 1 ] || die "Kimi-K3.1-Pro takes 32 GPUs: one job fits in ROMEO's 60-GPU limit" "dsh-romeo --models $DSH_ROMEO_MODELS --launch"
  JOBS=''
  [ "$LABEL" != Kimi-K3.1-Pro ] || jobs_known "$FICHE"
  if [ -n "$JOBS" ]; then
    say "Kimi job $(awk '{ print $1; exit }' <<<"$JOBS") already queued or running: no second one ${D}(32 GPUs each)${N}"
  else
    check_weights "$FICHE" "$WEIGHTS" "$LABEL"
    for _ in $(seq 1 "$n"); do launch_one "$FICHE"; done
  fi
  if [ -n "$SUB_FICHE" ]; then jobs_known "$SUB_FICHE"; [ -n "$JOBS" ] || { check_weights "$SUB_FICHE" "$SUB_WEIGHTS" "$SUB_LABEL"; launch_one "$SUB_FICHE"; }; fi
  if [ -n "$VOICE_FICHE" ]; then jobs_known "$VOICE_FICHE"; [ -n "$JOBS" ] || launch_one "$VOICE_FICHE"; fi
}

# The weights of a model before its job: a job that cannot read them fails after its wait in the
# queue. Kimi's are in a project's own storage, readable by that project's members only.
# $1 the fiche, $2 the weights path, $3 the model's name.
check_weights() {
  case $2 in /*) ;; *) return 0 ;; esac  # a Hugging Face id: romeollmtool's business
  weights_rc "$2"
  local rc=$WRC owner
  owner=$(printf '%s' "$2" | sed -n 's|^/project/\([^/]*\)/.*|\1|p')
  local where=''
  [ -z "$owner" ] || where=": they are in the storage of project $owner, open to its members only"
  case $rc in
    0) ;;
    3) die "your ROMEO login cannot read the weights of $3 ($2)$where" \
         "dsh-romeo --models deepseek --launch   (or ask to be added to project ${owner:-that owns them})" ;;
    4) die "$3's weights are not on ROMEO at $2 (moved or deleted?)" "dsh-romeo --setup   (an updated fiche), then dsh-romeo --doctor" ;;
    *) die "cannot check $3's weights on ROMEO (exit $rc)" "dsh-romeo --doctor" ;;
  esac
}

weights_rc() {  # $1 a weights path: WRC 0 readable, 3 a directory on the way this login cannot open, 4 missing
  # An unknown file system (not ROMEO's) says nothing: 0.
  WRC=0
  rsh "p=$(printf %q "$1"); [ -r \"\$p/config.json\" ] && exit 0; a=\$p
    while [ \"\$a\" != / ] && [ ! -e \"\$a\" ]; do a=\$(dirname \"\$a\"); done
    [ \"\$a\" = / ] && exit 0; [ -x \"\$a\" ] && [ -r \"\$a\" ] || exit 3; exit 4" </dev/null || WRC=$?
  lost "$WRC"
}

launch_one() {
  local out id
  local rc=0
  out=$(rlt launch "$1" --project-code "$ROMEO_PROJECT" --time "$DSH_ROMEO_TIME" --no-wait 2>&1) || rc=$?
  lost "$rc"
  if [ "$rc" != 0 ]; then
    case $out in
      *'Invalid account'* | *'invalid account'*)
        die "Slurm refuses project $ROMEO_PROJECT (not one of yours, or ended)" "$ROOT/install.sh --project rXXXXXX   (sacctmgr show assoc user=\$USER on ROMEO lists yours)" ;;
      *'Invalid qos'* | *'QOSMax'* | *'time limit'*)
        die "Slurm refuses the job: $(printf '%s\n' "$out" | tail -1)" "DSH_ROMEO_TIME=08:00:00 dsh-romeo --launch" ;;
      *'Disk quota'* | *'No space left'*)
        die "your ROMEO home is full: $(printf '%s\n' "$out" | tail -1)" "ssh $HOST 'du -sh ~/.romeollmtool/logs; df -h ~'   (old job logs can go)" ;;
      *) die "romeollmtool launch $1 failed: $(printf '%s\n' "$out" | tail -1)" "dsh-romeo --doctor   (project $ROMEO_PROJECT, fiches)" ;;
    esac
  fi
  id=$(printf '%s\n' "$out" | grep -oE '[0-9]{5,}' | head -1)
  SUBMITTED="$SUBMITTED ${id:-?}"
  say "model job ${id:-?} submitted ${D}($1, $DSH_ROMEO_TIME)${N}"
}

# ---------------------------------------------------------------- tunnel and model

open_tunnel() {  # 127.0.0.1:$PORT -> the gateway, kept when it already leads there
  local target=${GATEWAY#*://}
  target=${target%/v1}
  [ "$(cat "$CTL.target" 2>/dev/null)" = "$target" ] && probe_models >/dev/null 2>&1 && return 0
  forward "$PORT" "$target" "$CTL.target" && return 0
  # A refused forward with the port free: the SSH connection itself is in a bad state. Once more
  # on a new connection before giving up.
  if [ -z "$(port_holder "$PORT")" ]; then
    disconnect
    connect
    forward "$PORT" "$target" "$CTL.target" && return 0
  fi
  local holder
  holder=$(port_holder "$PORT")
  if [ -n "$holder" ]; then
    die "cannot forward 127.0.0.1:$PORT: ${holder% *} (pid ${holder#* }) listens on it" "kill ${holder#* }   (or another port: DSH_ROMEO_PORT=11328 dsh-romeo)"
  fi
  # Not --stop as the next step: it would also cancel the model jobs.
  die "cannot forward 127.0.0.1:$PORT: ssh refused it: ${FORWARD_ERROR:-no reason given}" "ssh -N -L $PORT:$target $HOST   (ssh's own reason, Ctrl-C to quit)"
}

# DSH_ROMEO_GATEWAY=fast: a second gateway on the login node, patched (share/gateway): no
# 100-stream cap, session affinity across model jobs, longer timeouts. Falls back to
# romeollmtool's gateway when it cannot start.
# shellcheck disable=SC2088  # expanded by the shell on ROMEO
FAST_DIR='~/.dsh-romeo/gateway'
FAST_PATTERN="[r]omeollmtool.gateway.server --host 0.0.0.0 --port $DSH_ROMEO_FAST_PORT"

ensure_fast_gateway() {
  local out
  # Copied, then started: any step that fails falls back, never a silent exit (set -e).
  if out=$(rsh "mkdir -p $FAST_DIR" 2>&1) \
     && out=$(rsh_stdin "cat > $FAST_DIR/sitecustomize.py" <"$ROOT/share/gateway/sitecustomize.py" 2>&1) \
     && out=$(rsh_stdin "cat > $FAST_DIR/start.sh && chmod +x $FAST_DIR/start.sh" <"$ROOT/share/gateway/start.sh" 2>&1) \
     && out=$(rsh "ROMEOLLMTOOL=$ROMEOLLMTOOL $FAST_DIR/start.sh $DSH_ROMEO_FAST_PORT $DSH_ROMEO_FAST_PROCS 2>&1"); then
    GATEWAY=http://localhost:$DSH_ROMEO_FAST_PORT/v1
    say "fast gateway ${G}running${N} ${D}(port $DSH_ROMEO_FAST_PORT, $DSH_ROMEO_FAST_PROCS processes)${N}"
  else
    say "${Y}fast gateway unavailable${N}, romeollmtool's gateway is used: $(printf '%s' "$out" | tail -1)"
  fi
}

# curl with "Authorization: Bearer $1" read from stdin, not from its arguments (seen by ps).
curl_key() {
  local key=$1
  shift
  printf 'header = "Authorization: Bearer %s"\n' "$key" | curl -K - "$@"
}

probe_models() {  # the gateway's model list, through the tunnel
  curl_key "$ROMEO_LLM_KEY" -sf -m 10 "http://127.0.0.1:$PORT/v1/models"
}

model_answers() {  # a one-token completion: model $1 is loaded and serving
  local code
  code=$(curl_key "$ROMEO_LLM_KEY" -s -o /dev/null -m 60 -w '%{http_code}' "http://127.0.0.1:$PORT/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1,\"reasoning_effort\":\"none\"}" || true)
  # A refused key never turns into a loaded model: say so now, not after the wait.
  case $code in
    401 | 403) die "the gateway refuses the key dsh-romeo read (HTTP $code, Clé API invalide ou absente)" "dsh-romeo --doctor" ;;
  esac
  [ "$code" = 200 ]
}

models_answer() { model_answers "$MODEL" && { [ -z "$SUB_MODEL" ] || model_answers "$SUB_MODEL"; }; }

# Dies when a model that does not answer has no job left to load it.
# Squeue not answering is no reason to stop: the next poll asks again.
check_jobs() {  # $1: what to say, $2: the command to type next
  local jobs f m
  for f in "$FICHE" "$SUB_FICHE"; do
    [ -n "$f" ] || continue
    m=$MODEL; [ "$f" = "$FICHE" ] || m=$SUB_MODEL
    if ! model_answers "$m" && jobs=$(jobs_of_fiche "$f" 2>/dev/null) && [ -z "$jobs" ]; then
      SUBMITTED=''
      why_ended "$f"
      die "$1 ($f)${WHY:+: $WHY}" "${NEXT:-$2}"
    fi
  done
}

# Why the last job of fiche $1 ended, from Slurm's accounting and the end of its log: WHY (one line,
# empty when nothing is known), NEXT (the command to type, empty for the caller's own), WHEN (HH:MM).
why_ended() {
  WHY='' NEXT='' WHEN=''
  local out acct state end nodes code
  out=$(rsh_stdin "bash -s -- $(printf %q "romeollmtool-$1")" <"$ROOT/share/why-ended.sh" 2>/dev/null) || return 0
  acct=$(printf '%s
' "$out" | sed -n 's/^acct=//p')
  [ -n "$acct" ] || return 0
  IFS='|' read -r _ state end nodes code <<<"$acct"
  WHEN=$(printf '%s' "$end" | sed -n 's/.*T\([0-9][0-9]:[0-9][0-9]\).*/\1/p')
  local hits
  hits=$(printf '%s
' "$out" | sed -n 's/^hit=//p')
  # A job someone cancelled (dsh-romeo --stop, the gateway) did not fail, whatever its log says.
  case $state in CANCELLED*) hits='' ;; esac
  case $hits in
    *"Free memory on device"*)
      WHY="a GPU had only $(printf '%s
' "$hits" | grep -m1 -oE '[0-9.]+/[0-9.]+ GiB' | head -1) free at start (memory an earlier job left on $nodes)"
      NEXT="dsh-romeo --launch   (another node; dsh-romeo --setup first installs the clean-up that frees it)" ;;
    *"No available memory for the cache blocks"*)
      WHY="no GPU memory left for the KV cache after the weights"
      NEXT="dsh-romeo --setup, then dsh-romeo --launch   (the fiche's memory settings)" ;;
    *"CUDA out of memory"* | *OutOfMemoryError*)
      WHY="the GPUs ran out of memory${nodes:+ on $nodes}"
      NEXT="dsh-romeo --launch   (again; dsh-romeo --logs for the details)" ;;
    *)
      case $state in
        TIMEOUT*) WHY="it reached its time limit (DSH_ROMEO_TIME=$DSH_ROMEO_TIME)"; NEXT="dsh-romeo --launch" ;;
        OUT_OF_ME*) WHY="the node ran out of host memory"; NEXT="dsh-romeo --launch" ;;
        NODE_FAIL*) WHY="its node $nodes failed"; NEXT="dsh-romeo --launch" ;;
        CANCELLED*)
          WHY="it was cancelled at ${WHEN:-?}"
          [ -n "$(gateway_url)" ] || WHY="$WHY: romeollmtool's gateway stopped (24 h lifetime), which cancels every job"
          NEXT="dsh-romeo --launch" ;;
        FAILED* | *) [ -n "$state" ] && WHY="Slurm says $state, exit $code$(printf '%s
' "$hits" | grep -m1 -E 'NCCL|Address|No such file' | sed 's/^/: /')" ;;
      esac ;;
  esac
}

wait_for_model() {
  local start jobs line shown='' width key slow=''
  start=$(date +%s)
  # Ctrl-C: a clean line and what to type next; the job keeps running.
  trap 'if [ -t 2 ]; then printf "\r\033[K" >&2; fi; say "stopped waiting: the model job keeps running"; note "dsh-romeo --status   follow it"; note "dsh-romeo            open dsh once it answers"; note "dsh-romeo --stop     cancel it"; exit 130' INT
  while ! models_answer; do
    check_jobs "the model job ended before the model answered" "dsh-romeo --logs   (then dsh-romeo --launch again)"
    jobs=$(jobs_of_fiches)
    check_blocked "$jobs"
    # Loading for much longer than usual (a slow file system, a hang): said once, the wait goes on.
    if [ -z "$slow" ] && [ "$(awk '$2 == "RUNNING" { print $3; exit }' <<<"$jobs" | { read -r t; minutes_of "${t:-0}"; })" -ge "$([ "$LABEL" = Kimi-K3.1-Pro ] && echo 35 || echo 25)" ]; then
      slow=1
      [ -z "$PROGRESS" ] || printf '\r\033[K' >&2
      say "${Y}the model has been loading for longer than usual${N}: dsh-romeo --logs shows where it is"
    fi
    line=$(waiting_line "$jobs" $(( $(date +%s) - start )))
    if [ -t 2 ]; then  # one line, rewritten in place: never wider than the terminal
      width=$(tput cols 2>/dev/null || echo 100)
      line=${line:0:$((width > 20 ? width - 11 : 10))}
      printf '\r\033[K%s %s' "${B}dsh-romeo${N}" "${D}$line${N}" >&2
      PROGRESS=1
    else  # a log: one line each time a job changes state, not at every poll
      key=$(awk '{ printf "%s %s ", $1, $2 }' <<<"$jobs")
      [ "$key" = "$shown" ] || say "$line"
      shown=$key
    fi
    sleep "${DSH_ROMEO_POLL:-15}"
  done
  trap - INT
  if [ -t 2 ]; then printf '\r\033[K' >&2; fi
  PROGRESS=''
  [ $(( $(date +%s) - start )) -lt "${DSH_ROMEO_NOTIFY_AFTER:-60}" ] || notify "$LABEL is ready on ROMEO"
}

notify() {  # after a long wait: the terminal bell and a desktop notification. DSH_ROMEO_NOTIFY=off: none
  [ "${DSH_ROMEO_NOTIFY:-on}" = on ] || return 0
  if [ -t 2 ]; then printf '\a' >&2; fi
  case $(uname) in
    Darwin) osascript -e "display notification \"$1\" with title \"dsh-romeo\"" >/dev/null 2>&1 || true ;;
    *) if command -v notify-send >/dev/null; then notify-send dsh-romeo "$1" 2>/dev/null || true; fi ;;
  esac
}

waiting_line() {  # $1: the jobs, $2: seconds waited
  local what="loading the model on ROMEO"
  grep -q ' RUNNING ' <<<"$1" || what="waiting for GPUs on ROMEO"
  printf '%s · %s · waited %d:%02d' "$what" "$(summary "$1")" $(($2 / 60)) $(($2 % 60))
}

summary() {  # one line for the jobs: "job 123 running 4:10" or "job 123 pending, starts ~14:32 (Resources)"
  local id st el left nodes start reason sep=''
  while read -r id st el left nodes start reason; do
    [ -n "$id" ] || continue
    printf '%sjob %s %s' "$sep" "$id" "$(printf '%s' "$st" | tr 'A-Z' 'a-z')"
    if [ "$st" = RUNNING ]; then printf ' %s' "$el"; else queue_eta "$start" "$reason"; fi
    sep=', '
  done <<<"$1"
}

# ---------------------------------------------------------------- dsh

overlay_model() {  # $1 model, $2 name, $3 context, $4 output limit, $5 inputs (text or text,image)
  cat <<YAML
          - id: $1
            name: $2 (ROMEO)
            contextWindow: $3
            maxTokens: $4
            input: [ ${5//,/, } ]
            reasoningEfforts: { off: none, low: low, high: high, max: max }
YAML
}

# DeepSeek beside Kimi (kimi+deepseek) also does the side work: the subagents, the session titles
# and, when it is on, dsh-prompt-predict. dsh composes its "subagent" tool inside each agent preset,
# which a patch cannot reach row by row, so the rows involved are restated whole from dsh's own
# composition (dsh --dump-config) with their route added: agentOptions for the subagent tool,
# provider/model for the title rows. $1: the dsh profile, $2: the dsh whose composition it is (the
# desktop app has its own, of its own version), $3: the profile whose plugins count (default $1).
helper_patch() {
  local manifest=$PROFILES/${3:-$1}/package.json dump bundle_patch extra=()
  bundle_patch=$(npm root -g 2>/dev/null || true)/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-experimental-session-titles-bundle/cordis.patch.yml
  # The all-prompts titles bundle of a profile that is not the dumped one (the app's).
  if [ -n "${3:-}" ] && profile_has_bundle "$manifest" @deepseek-ai/dsh-experimental-session-titles-bundle && [ -f "$bundle_patch" ]; then
    extra=(--patch "$bundle_patch")
  fi
  dump=$("${2:-$DSH}" --profile "$1" ${extra[@]+"${extra[@]}"} --dump-config 2>/dev/null) \
    && grep -q -- '- id: tool-subagent$' <<<"$dump" \
    || { say "${Y}cannot read dsh's composition${N}: subagents and titles keep $LABEL"; return 0; }
  printf '# Subagents (the "subagent" tool) and session titles on %s.\n' "$SUB_LABEL"
  awk -v model="$SUB_MODEL" -v effort="$DSH_ROMEO_EFFORT" '
    function flush() { if (hit) printf "%s", row; row = ""; hit = 0; top = "" }
    function lead(s) { match(s, /^ */); return RLENGTH }
    /^#/ { next }  # the dump'\''s source comments; blank lines belong to block scalars
    /^- / { flush(); inside = 0; top = $0; sub(/^- id: /, "", top) }
    {
      row = row $0 "\n"
      if ((top == "session-title-llm" || top == "optional-session-title-all-prompts") && $0 == "  config:") {
        row = row "    provider: romeo\n    model: " model "\n"
        hit = 1
      }
      if ($0 ~ /^ *- id: tool-subagent$/) { sub_at = lead($0); inside = 1; next }
      if (inside && $0 ~ /^ *- / && lead($0) <= sub_at) inside = 0
      if (inside && $0 ~ /^ *config:$/ && lead($0) == sub_at + 2) {
        pad = sprintf("%" (sub_at + 4) "s", "")
        row = row pad "agentOptions:\n" pad "  provider: romeo\n" pad "  model: " model "\n" pad "  reasoningEffort: \"" effort "\"\n"
        hit = 1; inside = 0
      }
    }
    END { flush() }' <<<"$dump"
  # The agent may also pick the model of a subagent (dsh's model selection, on in the Web and
  # desktop presets, off by default): $LABEL or $SUB_LABEL, each with its full context. Without a
  # choice, a subagent runs on $SUB_LABEL. (Without this setting dsh lets a subagent take only the
  # agent's own model, and the subagent tool's $SUB_LABEL route was ignored.) A subagent starts its
  # own subagents when dsh's subagent depth (its setting, 2 in the Web and desktop profiles) allows.
  cat <<YAML
# Subagents: the agent may choose $LABEL or $SUB_LABEL for each one ($SUB_LABEL by default).
- id: subagent-model-selection-settings
  config:
    enabled: true
    allowedModels:
      - { provider: romeo, model: $MODEL }
      - { provider: romeo, model: $SUB_MODEL }
YAML
  if profile_has_bundle "$manifest" dsh-prompt-predict; then
    cat <<YAML
# dsh-prompt-predict (on in this profile) on $SUB_LABEL, without reasoning: fast suggestions.
- id: dsh-prompt-predict
  config:
    provider: romeo
    model: $SUB_MODEL
    reasoningEffort: "off"
YAML
  fi
}

profile_has_bundle() {  # $1: a profile's package.json, $2: a bundle it selects
  [ -f "$1" ] && grep -q "\"$2\"" "$1" && node -e '
    const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))
    process.exit((d.dsh?.profile?.bundles ?? []).includes(process.argv[2]) ? 0 : 1)' "$1" "$2" 2>/dev/null
}

# Voice input: dsh's microphone button (its experimental voice bundle, without the local SenseVoice
# model) with Whisper on ROMEO as the recognizer. A profile that already has the voice bundle only
# gets the provider and the selection. $1: the dsh profile.
voice_patch() {
  printf '# Voice input: Whisper on ROMEO (%s).\n' "$FICHE_VOICE"
  if profile_has_bundle "$PROFILES/$1/package.json" @deepseek-ai/dsh-experimental-voice-input-bundle; then
    cat <<YAML
- id: speech-to-text
  config:
    defaultProvider: dsh-romeo-whisper
    language: auto
- insert:
YAML
  else
    cat <<YAML
- insert:
    - id: speech-to-text
      name: '@deepseek-ai/dsh-experimental-speech-to-text'
      config:
        defaultProvider: dsh-romeo-whisper
        language: auto
    - id: api-speech-to-text
      name: '@deepseek-ai/dsh-experimental-api-speech-to-text'
    - id: ui-voice-input
      name: '@deepseek-ai/dsh-experimental-client-ui-voice-input'
YAML
  fi
  cat <<YAML
    - id: dsh-romeo-whisper
      name: $ROOT/share/speech-whisper-romeo.mjs
      config:
        baseURL: http://127.0.0.1:$DSH_ROMEO_VOICE_PORT/v1
        apiKeyFile: $VOICE_KEY_FILE
        model: $VOICE_MODEL
YAML
}

yaml_str() { local q="'" s; s=${1//$q/$q$q}; printf '%s' "$q$s$q"; }  # a single-quoted YAML scalar

write_overlay() {  # $1: the dsh profile, $2: the dsh that runs it, $3: the profile whose plugins count
  mkdir -p "$CONFIG_DIR"
  local tmp  # its own temporary file: two starts at once never rename each other's half-written one
  tmp=$(mktemp "$OVERLAY.XXXXXX")
  {
    cat <<YAML
# Written by dsh-romeo at every start: edit $CONFIG_DIR/config instead.
# Adds the "romeo" provider ($LABEL${SUB_MODEL:+ and $SUB_LABEL} on ROMEO, through the SSH tunnel)
# and makes it the default model. The API key comes from the ROMEO_LLM_KEY environment variable.
- id: llm-pi-ai
  config:
    providers:
      romeo:
        displayName: ROMEO
        apiKeyEnv: ROMEO_LLM_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:$PORT/v1
        compat:
          supportsDeveloperRole: false
          supportsStore: false
          maxTokensField: max_tokens
        reasoning: "$DSH_ROMEO_EFFORT"
        streamIdleTimeoutMs: 600000
        models:
YAML
    overlay_model "$MODEL" "$LABEL" "$CONTEXT" "$MAX_TOKENS" "$INPUT"
    [ -z "$SUB_MODEL" ] || overlay_model "$SUB_MODEL" "$SUB_LABEL" "$SUB_CONTEXT" "$SUB_MAX_TOKENS" "$SUB_INPUT"
    cat <<YAML
- id: agent-default-model
  config:
    provider: romeo
    model: $MODEL
    reasoningEffort: "$DSH_ROMEO_EFFORT"
YAML
    [ -z "$SUB_MODEL" ] || helper_patch "${1:-web}" "${2:-}" "${3:-}"
    [ -z "$VOICE_FICHE" ] || voice_patch "${3:-${1:-web}}"
    if [ -n "$WEB_READY" ]; then
      cat <<YAML
# Web search through RustXNG on ROMEO (dsh-romeo --web on), over the shared SSH connection.
- id: web
  config:
    searchProvider: dsh-romeo-rustxng
    fetchProvider: http
- id: tool-web
  disabled: false
- insert:
    - id: dsh-romeo-rustxng
      name: $ROOT/share/web-search-romeo.mjs
      config:
        providerId: dsh-romeo-rustxng
        host: $(yaml_str "$HOST")
        socket: $(yaml_str "$CTL")
        binary: $(yaml_str "$RUSTXNG_BIN")
YAML
    elif [ -n "$DSH_ROMEO_SEARXNG_URL" ]; then
      cat <<YAML
# Web search through SearXNG (DSH_ROMEO_SEARXNG_URL).
- id: web
  config:
    searchProvider: dsh-romeo-searxng
    fetchProvider: http
- id: tool-web
  disabled: false
- insert:
    - id: dsh-romeo-searxng
      name: $ROOT/share/web-search-searxng.mjs
      config:
        providerId: dsh-romeo-searxng
        baseURL: $(yaml_str "$DSH_ROMEO_SEARXNG_URL")
YAML
    fi
  } >"$tmp"
  mv "$tmp" "$OVERLAY"
}

# dsh's credential store wins over the environment: a ROMEO_LLM_KEY saved there (in Settings, or by
# hand) would replace the key dsh-romeo passes, and the gateway would answer "Clé API invalide ou
# absente" once the model is up. dsh-romeo owns that name: such an entry is removed.
clear_stored_key() {  # $1: the dsh home (default: DSH_HOME, else ~/.dsh)
  local store=${1:-${DSH_HOME:-$HOME/.dsh}}/.credentials.yaml tmp
  [ -f "$store" ] && grep -q 'ROMEO_LLM_KEY:' "$store" || return 0
  tmp=$(umask 077; mktemp "$store.XXXXXX")  # never world-readable, never shared with another start
  # Block or flow style; a refs map left empty is written "refs: {}" (a bare "refs:" is null, and
  # dsh then cannot save any key).
  awk '
    function close_refs() { if (hold) { printf "%s {}\n%s", hdr, buf; hold = 0; buf = "" } }
    /^refs:[[:space:]]*\{/ { sub(/[[:space:]]*ROMEO_LLM_KEY:[^,}]*,?/, ""); print; next }
    /^[^[:space:]#]/ { close_refs(); refs = ($0 ~ /^refs:[[:space:]]*$/); skip = 0; if (refs) { hdr = $0; hold = 1; next } }
    skip && match($0, /^ */) && RLENGTH > lead { next }
    { skip = 0 }
    refs && /^[[:space:]]+ROMEO_LLM_KEY:/ { match($0, /^ */); lead = RLENGTH; skip = 1; next }
    hold && /^[[:space:]]+[^[:space:]#]/ { printf "%s\n%s", hdr, buf; hold = 0; buf = "" }
    hold { buf = buf $0 "\n"; next }
    { print }
    END { close_refs() }' "$store" >"$tmp"
  if cmp -s "$store" "$tmp"; then rm -f "$tmp"; return 0; fi
  mv "$tmp" "$store"
  say "${Y}removed a ROMEO_LLM_KEY saved in dsh's credentials${N}: it replaced the gateway's key"
  note "$store"
}

run_dsh() {
  local profile=${1:-web}
  write_overlay "$profile"
  clear_stored_key
  [ $# -gt 0 ] && shift
  export ROMEO_LLM_KEY
  exec "$DSH" "$profile" --patch "$OVERLAY" "$@"
}

# The DeepSeek Harness desktop app (macOS) runs dsh on its own "desktop" profile and takes no
# --patch: the overlay goes into that profile's cordis.patch.yml. A patch of your own there is
# kept once as cordis.patch.yml.before-dsh-romeo.
DESKTOP_APP=${DSH_ROMEO_DESKTOP_APP:-DeepSeek Harness}

desktop_dsh() {  # the dsh command line inside the app, empty when not found
  local app
  for app in "/Applications/$DESKTOP_APP.app" "$HOME/Applications/$DESKTOP_APP.app"; do
    [ -x "$app/Contents/Resources/runtime/cli/bin/dsh" ] && { echo "$app/Contents/Resources/runtime/cli/bin/dsh"; return; }
  done
  return 0
}

# The overlay, then the rows of the app's patch $1 that are not dsh-romeo's: the app saves its own
# settings (theme, permissions, account...) in that file, and they are kept from one start to the
# next. dsh-romeo's rows of an earlier start go, even those this one does not write again.
merge_desktop_patch() {
  cat "$OVERLAY"
  [ -f "$1" ] || return 0
  # Rows the overlay writes again are replaced; rows of an earlier start under ids dsh-romeo uses go
  # only when they carry its marks (the romeo provider, its plugins), not the app's own settings.
  awk -v ids="$(sed -n 's/^- id: //p' "$OVERLAY" | tr '\n' ' ')" -v earlier="llm-pi-ai agent-default-model tool-subagent session-title-llm optional-session-title-all-prompts dsh-prompt-predict speech-to-text subagent-model-selection-settings" '
    BEGIN {
      n = split(ids, a, " "); for (i = 1; i <= n; i++) ours[a[i]] = 1
      n = split(earlier, a, " "); for (i = 1; i <= n; i++) old[a[i]] = 1
    }
    function flush() {
      if (row != "" && !(id in ours) && !((id in old) && row ~ /romeo/) && row !~ /dsh-romeo-searxng/ && row !~ /dsh-romeo-rustxng/ && row !~ /dsh-romeo-whisper/ && row !~ /agentOptions:\n *provider: romeo\n/)
        printf "%s", row
      row = ""; id = ""
    }
    /^#/ { next }
    /^\[\][[:space:]]*$/ { next }  # an empty patch written as a flow list
    /^- / { flush(); id = $0; sub(/^- id: /, "", id) }
    { if (row != "" || $0 !~ /^[[:space:]]*$/) row = row $0 "\n" }
    END { flush() }' "$1"
}
run_desktop() {
  # The desktop profile is the app's own (no --dump-config): its presets are the Web UI's, read
  # with the app's own dsh, whose version can differ from the dsh installed with npm.
  local app_dsh
  app_dsh=${DSH_ROMEO_DESKTOP_DSH:-$(desktop_dsh)}
  # An app update can move its dsh: never restate the presets of another dsh's version in its profile.
  if [ -z "$app_dsh" ] && [ -n "$SUB_MODEL" ]; then
    say "${Y}the app's dsh not found in $DESKTOP_APP.app${N}: subagents and titles keep $LABEL (DSH_ROMEO_DESKTOP_DSH)"
    app_dsh=false
  fi
  # The app, started by open(1), does not get this shell's DSH_HOME: its profile is in ~/.dsh.
  local PROFILES=$HOME/.dsh/profiles
  write_overlay web "$app_dsh" desktop
  local dir=$PROFILES/desktop
  local patch=$dir/cordis.patch.yml
  mkdir -p "$dir" 2>/dev/null || die "cannot create $dir (the app's profile)" "ls -ld $HOME/.dsh   (owned by another user? sudo was used once?)"
  [ -w "$dir" ] && { [ ! -e "$patch" ] || [ -w "$patch" ]; } \
    || die "cannot write the app's profile in $dir" "ls -l $dir   (owned by another user? sudo was used once?)"
  if [ -f "$patch" ] && ! grep -q '^# Written by dsh-romeo' "$patch" && grep -q -v -E '^[[:space:]]*(#|\[\][[:space:]]*$|$)' "$patch" \
     && [ ! -e "$patch.before-dsh-romeo" ]; then
    cp "$patch" "$patch.before-dsh-romeo"
    note "a copy of your desktop patch before dsh-romeo: $patch.before-dsh-romeo"
  fi
  if desktop_current "$patch"; then
    say "$DESKTOP_APP ${G}already runs on ROMEO${N} ${D}(same key, same settings): not restarted, the tunnel is open${N}"
    return 0
  fi
  # The app reads its environment at start only, and rewrites its profile while it runs: a running
  # copy is quit before the patch is written (its sessions are kept).
  if pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/"; then
    say "restarting $DESKTOP_APP so it gets the ROMEO key"
    osascript -e "quit app \"$DESKTOP_APP\"" >/dev/null 2>&1 || true
    local _
    for _ in $(seq 1 30); do pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/" || break; sleep 1; done
    ! pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/" \
      || die "$DESKTOP_APP did not quit within 30 s (a dialog open?): quit it, then run dsh-romeo --desktop again"
  fi
  clear_stored_key "$HOME/.dsh"
  local tmp
  tmp=$(mktemp "$patch.XXXXXX")  # two --desktop at once never mix their halves of the app's settings
  merge_desktop_patch "$patch" >"$tmp"
  mv "$tmp" "$patch" || die "cannot write $patch" "ls -l $dir   (the app's profile folder)"
  say "opening $DESKTOP_APP ${D}(the tunnel stays open until dsh-romeo --stop)${N}"
  local out
  out=$(open -a "$DESKTOP_APP" --env "ROMEO_LLM_KEY=$ROMEO_LLM_KEY" 2>&1) \
    || die "macOS did not open $DESKTOP_APP: ${out:-no reason given}" "open -a '$DESKTOP_APP'   (macOS's own message; reinstall the app if it is damaged)"
  remember_desktop_key
  # The app should be up within 30 s: a crash at start or a macOS dialog (first opening) shows here.
  local _
  for _ in $(seq 1 "${DSH_ROMEO_APP_WAIT:-30}"); do pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/" && return 0; sleep 1; done
  say "${Y}$DESKTOP_APP is not running 30 s after opening${N}: a macOS dialog may wait for you"
  note "the tunnel is open: open the app again by hand once it is fixed, then dsh-romeo --desktop"
}

# The key, for apps opened later from the Dock or Spotlight (they do not get this shell's
# environment): launchd's environment for this session, until dsh-romeo --stop or a restart.
remember_desktop_key() {
  command -v launchctl >/dev/null || return 0
  launchctl setenv ROMEO_LLM_KEY "$ROMEO_LLM_KEY" 2>/dev/null || true
  (umask 077; desktop_state >"$CONFIG_DIR/desktop.key-sum")
}

# What the running app was started with, beyond its profile's patch: the key, and the home-level
# patch it also reads at start (~/.dsh/cordis.patch.yml).
desktop_state() { { printf '%s\n' "$ROMEO_LLM_KEY"; cat "$HOME/.dsh/cordis.patch.yml" 2>/dev/null; } | cksum; }

# The app already runs with this key and these patches (after a sleep, the tunnel only had to be
# reopened): no restart, the app keeps its windows.
desktop_current() {  # $1 the app's patch: 0 when nothing would change
  pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/" || return 1
  [ "$(desktop_state)" = "$(cat "$CONFIG_DIR/desktop.key-sum" 2>/dev/null)" ] || return 1
  local tmp rc=1
  tmp=$(mktemp "$1.XXXXXX")
  merge_desktop_patch "$1" >"$tmp" && cmp -s "$tmp" "$1" && rc=0
  rm -f "$tmp"
  return $rc
}

# ---------------------------------------------------------------- other clients

# The endpoint in the variables that OpenAI- and Anthropic-compatible clients read.
export_endpoint() {
  BASE_URL=http://127.0.0.1:$PORT/v1
  local small=${SUB_MODEL:-$MODEL}  # Claude Code runs its subagents and small tasks on Haiku
  export ROMEO_LLM_KEY DSH_ROMEO_MODEL=$MODEL DSH_ROMEO_SUB_MODEL=$small DSH_ROMEO_BASE_URL=$BASE_URL
  export OPENAI_BASE_URL=$BASE_URL OPENAI_API_BASE=$BASE_URL OPENAI_API_KEY=$ROMEO_LLM_KEY
  export ANTHROPIC_BASE_URL=http://127.0.0.1:$PORT ANTHROPIC_AUTH_TOKEN=$ROMEO_LLM_KEY ANTHROPIC_MODEL=$MODEL
  export ANTHROPIC_DEFAULT_OPUS_MODEL=$MODEL ANTHROPIC_DEFAULT_SONNET_MODEL=$MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL=$small
  export ANTHROPIC_SMALL_FAST_MODEL=$small CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  export AIDER_MODEL=openai/$MODEL
  write_opencode_config
  export OPENCODE_CONFIG=$CONFIG_DIR/opencode.json
}

opencode_model() {  # $1 model, $2 name, $3 context, $4 output limit
  printf '        "%s": {\n          "name": "%s (ROMEO)",\n          "reasoning": true,\n          "tool_call": true,\n          "limit": { "context": %s, "output": %s }\n        }' "$@"
}

write_opencode_config() {  # a "romeo" provider for opencode; the key stays in the environment
  mkdir -p "$CONFIG_DIR"
  {
    cat <<JSON
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "romeo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ROMEO",
      "options": { "baseURL": "http://127.0.0.1:$PORT/v1", "apiKey": "{env:ROMEO_LLM_KEY}" },
      "models": {
JSON
    opencode_model "$MODEL" "$LABEL" "$CONTEXT" "$MAX_TOKENS"
    [ -z "$SUB_MODEL" ] || { printf ',\n'; opencode_model "$SUB_MODEL" "$SUB_LABEL" "$SUB_CONTEXT" "$SUB_MAX_TOKENS"; }
    cat <<JSON

      }
    }
  },
  "model": "romeo/$MODEL",
  "small_model": "romeo/${SUB_MODEL:-$MODEL}"
}
JSON
  } >"$CONFIG_DIR/opencode.json.tmp"
  mv "$CONFIG_DIR/opencode.json.tmp" "$CONFIG_DIR/opencode.json"
}

# What this computer needs for the command, checked before anything starts on ROMEO: a missing
# program found after the model's 10-minute load would leave its job running for nothing.
preflight() {  # $1: --desktop, --serve, --env, --run CMD, or a dsh profile
  case ${1:-} in
    --desktop)
      [ "$(uname)" = Darwin ] || die "--desktop: the DeepSeek Harness desktop app is for macOS" "dsh-romeo   (the Web UI)"
      open -Ra "$DESKTOP_APP" 2>/dev/null || die "the $DESKTOP_APP app is not installed" "open https://github.com/deepseek-ai/deepseek-harness/releases" ;;
    --serve | --env) ;;
    --run) command -v "$2" >/dev/null || die "--run $2: command not found on this computer" "dsh-romeo --run opencode   (or codex, claude, aider...)" ;;
    -*) die "unknown option $1" "dsh-romeo --help" ;;
    *) command -v "$DSH" >/dev/null || die "dsh is not installed" "$ROOT/install.sh   (it installs the dsh that fits your Node.js)" ;;
  esac
}

run_client() {  # exec a client with the endpoint in its environment (and in its flags for codex)
  export_endpoint
  case $(basename "$1") in
    codex)  # Codex takes custom providers from its config only, and speaks the Responses API to them
      local cmd=$1
      shift
      exec "$cmd" -c model_provider=romeo -c model="$MODEL" \
        -c "model_providers.romeo={ name = \"ROMEO\", base_url = \"$BASE_URL\", env_key = \"ROMEO_LLM_KEY\", wire_api = \"responses\" }" "$@" ;;
  esac
  exec "$@"
}

print_env() {
  export_endpoint
  local v
  for v in ROMEO_LLM_KEY DSH_ROMEO_MODEL DSH_ROMEO_SUB_MODEL DSH_ROMEO_BASE_URL OPENAI_BASE_URL OPENAI_API_BASE OPENAI_API_KEY \
           ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL \
           ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_SMALL_FAST_MODEL \
           CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC AIDER_MODEL OPENCODE_CONFIG; do
    printf 'export %s=%q\n' "$v" "${!v}"
  done
}

print_serve() {
  cat <<TEXT
$LABEL${SUB_MODEL:+ and $SUB_LABEL} on ROMEO, an OpenAI-compatible endpoint for any client:
  base URL   http://127.0.0.1:$PORT/v1
  model      $MODEL${SUB_MODEL:+
  subagents  $SUB_MODEL}
  API key    the gateway's: eval "\$(dsh-romeo --env)" puts it in OPENAI_API_KEY and ROMEO_LLM_KEY
The tunnel stays open until dsh-romeo --stop (after this computer sleeps, run dsh-romeo --serve again).
TEXT
}

# ---------------------------------------------------------------- commands

status_row() {  # $1 what, $2 state, $3 its color, $4 detail: aligned columns, colors outside the padding
  printf '  %-9s %s%-8s%s %s\n' "$1" "$3" "$2" "$N" "$4" >&2
}

cmd_logs() {  # $1: -f to follow. The agent's model job, else any dsh-romeo job (the subagents', Whisper)
  connect
  local f id=''
  for f in $(printf '%s\n' $FICHES "$FICHE_DEEPSEEK" "$FICHE_KIMI" "$FICHE_VOICE" | awk '!seen[$0]++'); do
    id=$(jobs_of_fiche "$f" | awk 'NR == 1 { print $1 }') || true
    [ -z "$id" ] || break
  done
  case ${1:-} in '' | -f) ;; *) die "--logs takes -f or nothing, not '$1'" "dsh-romeo --logs -f" ;; esac
  if [ -z "$id" ]; then  # a job that ended while loading: romeollmtool keeps the log of the last one
    say "no model job in the queue: the log of your last romeollmtool job"
    rlt logs -n 40 || die "romeollmtool has no log to show" "dsh-romeo --launch"
    return 0
  fi
  say "log of model job $id ${D}($f)${N}"
  if [ "${1:-}" = -f ]; then
    # A terminal for the remote side, so that it stops with the session (-tt without a local one).
    # Through the shared connection only: never a new login that could ask for a password.
    local o=(-S "$CTL" -o ControlMaster=no -o BatchMode=yes)
    if [ -t 0 ] && [ -t 1 ]; then exec ssh -t "${o[@]}" "$HOST" "$ROMEOLLMTOOL logs -n 40 --follow $id" 2> >(quiet); fi
    exec ssh -tt "${o[@]}" "$HOST" "$ROMEOLLMTOOL logs -n 40 --follow $id" </dev/null 2> >(quiet)
  fi
  rlt logs -n 40 "$id" || die "romeollmtool logs $id failed" "ssh $HOST $ROMEOLLMTOOL logs $id"
}

cmd_doctor() {  # each check on one row; exit 1 if one fails. Starts nothing on ROMEO.
  local failed=0 v dsh_v f
  pass() { status_row "$1" ok "$G" "$2"; }
  warn() { status_row "$1" warning "$Y" "$2"; }
  fail() { status_row "$1" failed "$R" "$2"; failed=1; }
  say "doctor ${D}--models $DSH_ROMEO_MODELS --voice $DSH_ROMEO_VOICE --web $DSH_ROMEO_WEB${N}"
  # This computer
  if command -v node >/dev/null; then
    v=$(node --version)
    if node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 20 || (a == 20 && b >= 3) ? 0 : 1)'; then
      pass node "$v"
    else fail node "$v is too old: Node.js 20.3 or later"; fi
  else fail node "not installed: https://nodejs.org"; fi
  if command -v "$DSH" >/dev/null; then
    dsh_v=$("$DSH" --version 2>/dev/null </dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | tail -1) || true
    case $dsh_v in
      0.2.[2-9]* | 0.2.[1-9][0-9]* | 0.[3-9].* | 0.[1-9][0-9]*.* | [1-9]*)
        if node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 24 || (a == 24 && b >= 9) ? 0 : 1)' 2>/dev/null; then
          pass dsh "$dsh_v"
        else fail dsh "$dsh_v needs Node.js 24.9 or later (node $(node --version 2>/dev/null))"; fi ;;
      '') warn dsh "installed, version unreadable" ;;
      *) pass dsh "$dsh_v" ;;
    esac
  else fail dsh "not installed: $ROOT/install.sh"; fi
  # The local end of the tunnel: free, or held by dsh-romeo's own SSH connection.
  if [ -s "$CTL.target" ] && mux check; then pass port "127.0.0.1:$PORT, dsh-romeo's tunnel"
  elif command -v lsof >/dev/null && v=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -Fc 2>/dev/null | sed -n 's/^c//p' | head -1) && [ -n "$v" ] && [ "$v" != ssh ]; then
    fail port "127.0.0.1:$PORT is held by $v: set DSH_ROMEO_PORT"
  else pass port "127.0.0.1:$PORT"; fi
  if [ "$DSH_ROMEO_WEB" = on ] || [ -n "$DSH_ROMEO_SEARXNG_URL" ]; then
    v=$(home_web_override)
    if [ -n "$v" ]; then warn "web row" "$v sets dsh's web search and wins over dsh-romeo's: remove its '- id: web' row"
    else pass "web row" "no web search of your own in ${DSH_HOME:-$HOME/.dsh}/cordis.patch.yml"; fi
  fi
  if grep -q 'ROMEO_LLM_KEY:' "${DSH_HOME:-$HOME/.dsh}/.credentials.yaml" 2>/dev/null; then
    warn "dsh key" "a ROMEO_LLM_KEY saved in dsh replaces the gateway's: dsh-romeo removes it"
  else pass "dsh key" "none saved in dsh: it takes the gateway's"; fi
  # ROMEO. A connection doctor opens is closed when it ends.
  mux check || trap disconnect EXIT
  if ( connect ) 2>/dev/null; then pass ssh "$HOST"
  else
    fail ssh "cannot log in to '$HOST' without a password: ssh $HOST hostname"
    [ "$failed" = 0 ] || die "doctor: a check failed"
  fi
  if v=$(rlt version 2>/dev/null </dev/null | head -1) && [ -n "$v" ]; then pass tool "romeollmtool ${v#romeollmtool }"
  else fail tool "romeollmtool not found at $ROMEOLLMTOOL on ROMEO (set ROMEOLLMTOOL)"; fi
  if [ -n "$ROMEO_PROJECT" ]; then pass project "$ROMEO_PROJECT"; else fail project "none: $ROOT/install.sh --project rXXXXXX"; fi
  for f in $FICHES; do
    if rlt catalog show "$f" >/dev/null 2>&1 </dev/null; then pass fiche "$f"
    else fail fiche "$f is not on ROMEO: dsh-romeo --setup"; continue; fi
    # The weights: a login outside the project that stores them (Kimi's) cannot launch that model.
    local w
    w=$(rlt catalog show "$f" 2>/dev/null </dev/null | awk '/^vllm:/ { v = 1; next } /^[^ -]/ { v = 0 } v && /^  model:/ { gsub(/["\047]/, "", $2); print $2; exit }') || true
    case $w in /*) ;; *) continue ;; esac
    weights_rc "$w"
    case $WRC in
      0) pass weights "$(label_of "$f")" ;;
      3) fail weights "$(label_of "$f"): your login cannot read $w$(printf '%s' "$w" | sed -n 's|^/project/\([^/]*\)/.*|, open to project \1 members only: --models deepseek|p')" ;;
      *) fail weights "$(label_of "$f"): not found at $w" ;;
    esac
  done
  local key url code=''
  key=$(rlt gateway show-key 2>/dev/null </dev/null | tr -d '[:space:]') || true
  url=$(gateway_url)
  # The key against the gateway itself: through the tunnel when it is open, else from the login node.
  if [ -n "$key" ] && [ -s "$CTL.target" ]; then
    code=$(curl_key "$key" -s -o /dev/null -m 10 -w '%{http_code}' "http://127.0.0.1:$PORT/v1/models") || true
  elif [ -n "$key" ] && [ -n "$url" ]; then
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$key" | rsh_stdin "curl -K - -s -o /dev/null -m 10 -w '%{http_code}' $url/models" 2>/dev/null) || true
  fi
  if [ -z "$key" ]; then fail key "cannot read it: ssh $HOST $ROMEOLLMTOOL gateway show-key"
  else
    case $code in
      401 | 403) fail key "the gateway refuses the key show-key prints (HTTP $code)" ;;
      200) pass key "accepted by the gateway" ;;
      *) pass key "readable (romeollmtool gateway show-key)" ;;
    esac
  fi
  if [ -n "$url" ]; then pass gateway running; else warn gateway "stopped: the next dsh-romeo starts it"; fi
  if [ "$DSH_ROMEO_WEB" = on ]; then
    case $(rustxng check) in
      ok) pass web "RustXNG 0.28.0 on ROMEO, checksum verified" ;;
      *) warn web "RustXNG not installed on ROMEO yet: the next dsh-romeo installs it" ;;
    esac
  fi
  [ "$failed" = 0 ] || die "doctor: a check failed"
  say "doctor: ${G}all good${N}"
}

cmd_completion() {  # $1: bash or zsh. Options, then the values of --models, --voice and --completion.
  local words="--models --voice --web --launch --desktop --run --serve --env --status --stop --setup --logs --doctor --completion --version --help"
  case ${1:-} in
    bash | zsh) ;;
    *) die "--completion takes bash or zsh" 'eval "$(dsh-romeo --completion zsh)"   # in ~/.zshrc' ;;
  esac
  [ "$1" = bash ] || printf '%s\n' '(( $+functions[compdef] )) || { autoload -U +X compinit && compinit; }' 'autoload -U +X bashcompinit && bashcompinit'
  cat <<EOF
_dsh_romeo() {
  local cur=\${COMP_WORDS[COMP_CWORD]} prev=\${COMP_WORDS[COMP_CWORD-1]}
  case \$prev in
    --models) COMPREPLY=(\$(compgen -W "deepseek kimi kimi+deepseek" -- "\$cur")); return ;;
    --voice | --web) COMPREPLY=(\$(compgen -W "on off" -- "\$cur")); return ;;
    --completion) COMPREPLY=(\$(compgen -W "bash zsh" -- "\$cur")); return ;;
    --logs) COMPREPLY=(\$(compgen -W "-f" -- "\$cur")); return ;;
    --run) COMPREPLY=(\$(compgen -c -- "\$cur")); return ;;
  esac
  COMPREPLY=(\$(compgen -W "$words \$(ls "\${DSH_HOME:-\$HOME/.dsh}/profiles" 2>/dev/null)" -- "\$cur"))
}
complete -F _dsh_romeo dsh-romeo
EOF
}

cmd_version() {
  local commit app_dsh
  commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)
  echo "dsh-romeo $VERSION${commit:+ ($commit)}"
  echo "dsh       $("$DSH" --version 2>/dev/null </dev/null || echo 'not installed')"
  if [ "$(uname)" = Darwin ] && app_dsh=$(desktop_dsh 2>/dev/null) && [ -n "$app_dsh" ]; then
    echo "app dsh   $("$app_dsh" --version 2>/dev/null </dev/null || echo '?')"
  fi
  echo "node      $(node --version 2>/dev/null || echo 'not installed')"
}

cmd_status() {
  connect
  local url f jobs id st el left nodes start reason when target procs
  say "status ${D}--models $DSH_ROMEO_MODELS --voice $DSH_ROMEO_VOICE --web $DSH_ROMEO_WEB${ROMEO_PROJECT:+, project $ROMEO_PROJECT}${N}"
  url=$(gateway_url)
  if [ -n "$url" ]; then status_row gateway running "$G" "$url"; else status_row gateway stopped "$Y" "${D}the next dsh-romeo starts it${N}"; fi
  if [ "$DSH_ROMEO_GATEWAY" = fast ]; then
    procs=$(rsh "pgrep -u \$USER -f '^[^ ]*python[^ ]* -m $FAST_PATTERN' | wc -l" | tr -d '[:space:]')  # not the timeout wrappers
    if [ "${procs:-0}" -gt 0 ]; then status_row "fast gw" running "$G" "port $DSH_ROMEO_FAST_PORT, $procs processes"
    else status_row "fast gw" stopped "$Y" ""; fi
  fi
  # Open: this connection forwards the port (dsh-romeo wrote its target) and something answers there.
  target=$(cat "$CTL.target" 2>/dev/null || true)
  if [ -n "$target" ] && curl -s -m 3 -o /dev/null "http://127.0.0.1:$PORT/v1/models"; then
    status_row tunnel open "$G" "127.0.0.1:$PORT -> $target"
  else
    status_row tunnel closed "$Y" "${D}dsh-romeo or dsh-romeo --serve opens it${N}"
  fi
  if [ "$DSH_ROMEO_WEB" = on ]; then
    case $(rustxng check) in
      ok) status_row web on "$G" "RustXNG on the ROMEO login node" ;;
      *) status_row web missing "$Y" "${D}the next dsh-romeo installs RustXNG on ROMEO${N}" ;;
    esac
  fi
  printf '  %s%-25s %-8s %-8s %-5s %s%s\n' "$D" MODEL JOB STATE NODES TIME "$N" >&2
  for f in $FICHES; do
    if ! jobs=$(jobs_of_fiche "$f"); then
      printf '  %-25s %-8s %s%-8s%s %-5s %s\n' "$(label_of "$f")" - "$R" unknown "$N" - "${D}squeue did not answer: try again${N}" >&2
      continue
    fi
    if [ -z "$jobs" ]; then
      why_ended "$f"
      case $WHY in
        '' | "it was cancelled"*"gateway"* | "it was cancelled at"*) printf '  %-25s %-8s %s%-8s%s %-5s %s\n' "$(label_of "$f")" - "$Y" "no job" "$N" - "${D}dsh-romeo --launch${WHY:+ (last one: $WHY)}${N}" >&2 ;;
        *) printf '  %-25s %-8s %s%-8s%s %-5s %s\n' "$(label_of "$f")" - "$R" "failed" "$N" - "${WHEN:+$WHEN: }$WHY" >&2 ;;
      esac
      continue
    fi
    while read -r id st el left nodes start reason; do
      case $st in
        RUNNING) when="$el elapsed, $left left" ;;
        PENDING) when=$(queue_eta "$start" "$reason"); when=${when#, }; when=${when:-in the queue} ;;
        *) when=$el ;;
      esac
      printf '  %-25s %-8s %s%-8s%s %-5s %s\n' "$(label_of "$f")" "$id" "$([ "$st" = RUNNING ] && echo "$G" || echo "$Y")" \
        "$(printf '%s' "$st" | tr 'A-Z' 'a-z')" "$N" "$nodes" "$when" >&2
    done <<<"$jobs"
  done
}

cmd_stop() {  # the jobs of every dsh-romeo model, also those of a choice of models made earlier
  connect
  local jobs id f stopped=0 unknown=''
  for f in $(printf '%s\n' $FICHES "$FICHE_DEEPSEEK" "$FICHE_KIMI" "$FICHE_VOICE" | awk '!seen[$0]++'); do
    if ! jobs=$(jobs_of_fiche "$f"); then
      say "${Y}cannot list the jobs of $f${N}: squeue did not answer"
      unknown="$unknown $f"
      continue
    fi
    for id in $(printf '%s\n' "$jobs" | awk '{print $1}'); do
      if rlt stop "$id" </dev/null >/dev/null 2>&1 || rsh "scancel $id" 2>/dev/null; then
        say "model job $id stopped ${D}($f)${N}"
        stopped=1
      else
        say "${Y}model job $id not stopped${N} ${D}($f: already ending? dsh-romeo --status)${N}"
      fi
    done
  done
  [ "$stopped" = 1 ] || [ -n "$unknown" ] || say "no model job of dsh-romeo"
  if [ "$DSH_ROMEO_GATEWAY" = fast ]; then
    rsh "pkill -u \$USER -f '$FAST_PATTERN'" && say "fast gateway stopped"
  fi
  disconnect
  stop_voice_watch
  rm -f "$CTL.target" "$CTL.voice" "$VOICE_KEY_FILE" "$CONFIG_DIR/desktop.key-sum"
  if [ "$(uname)" = Darwin ] && command -v launchctl >/dev/null; then launchctl unsetenv ROMEO_LLM_KEY 2>/dev/null || true; fi
  # Connections opened with an earlier ROMEO_SSH_HOST: they would keep holding the ports.
  local s s_host
  [ -n "${DSH_ROMEO_SOCKET:-}" ] || for s in "$HOME"/.ssh/dsh-romeo-*.sock; do
    [ -e "$s" ] && [ "$s" != "$CTL" ] || continue
    s_host=${s##*/dsh-romeo-}
    ssh -S "$s" -O exit "${s_host%.sock}" 2>/dev/null && say "closed an earlier connection ${D}(${s_host%.sock})${N}"
    rm -f "$s" "$s.target" "$s.voice"
  done
  say "tunnel closed ${D}(romeollmtool's gateway stops by itself)${N}"
  # Jobs that could not be listed may still run, and use GPU hours.
  [ -z "$unknown" ] || die "some model jobs may still run:$unknown" "dsh-romeo --stop   (again in a minute)"
}

cmd_setup() {
  connect
  rlt version >/dev/null 2>&1 || die "romeollmtool not found at $ROMEOLLMTOOL on ROMEO" "dsh-romeo --doctor"
  local out
  out=$(rsh "mkdir -p ~/.romeollmtool/configs" 2>&1) || die "cannot create ~/.romeollmtool/configs on ROMEO: $out" "ssh $HOST 'df -h ~'   (ROMEO home full?)"
  for f in "$ROOT"/share/fiches/*.yaml; do
    # __USER__ in a fiche: your ROMEO login (romeollmtool writes fiche values as they are).
    out=$(rsh_stdin "sed \"s/__USER__/\$USER/g\" > ~/.romeollmtool/configs/$(basename "$f")" <"$f" 2>&1) \
      || die "cannot write fiche $(basename "$f" .yaml) on ROMEO: $(printf '%s\n' "$out" | tail -1)" "ssh $HOST 'df -h ~'   (ROMEO home full?)"
    say "fiche $(basename "$f" .yaml) installed in ~/.romeollmtool/configs on ROMEO"
  done
  # The clean-up the fiches run before a job starts (their PYTHONPATH).
  out=$(rsh_stdin "mkdir -p ~/.dsh-romeo/prestart && cat > ~/.dsh-romeo/prestart/sitecustomize.py" <"$ROOT/share/prestart/sitecustomize.py" 2>&1) \
    || die "cannot write ~/.dsh-romeo/prestart on ROMEO: $(printf '%s\n' "$out" | tail -1)" "ssh $HOST 'df -h ~'"
  say "job clean-up installed in ~/.dsh-romeo/prestart on ROMEO"
}

# Web search on ROMEO (--web on): RustXNG's static binary on the login node, run per search by
# share/web-search-romeo.mjs over the shared SSH connection (`rustxng mcp`, stdin/stdout): no port
# open on a node other users share. Pinned to 0.28.0 by its SHA-256.
RUSTXNG_SHA256=${DSH_ROMEO_RUSTXNG_SHA256:-91b8f3f9a519b1737d22d025fbe1b6b6264a00fd2ae0a1ff103476ada766b5e8}
RUSTXNG_URL=${DSH_ROMEO_RUSTXNG_URL:-https://github.com/sahenjp/RustXNG/releases/download/v0.28.0/rustxng-v0.28.0-x86_64-unknown-linux-musl}
# shellcheck disable=SC2088  # expanded by the shell on ROMEO
RUSTXNG_BIN='~/.dsh-romeo/rustxng/rustxng-v0.28.0-x86_64-unknown-linux-musl'
WEB_READY=''

rustxng() {  # $1: install or check. The script's answer (ok, installed, missing, or why not)
  rsh_stdin "bash -s -- $(printf %q "$RUSTXNG_SHA256") $(printf %q "$RUSTXNG_URL") $1" <"$ROOT/share/rustxng-install.sh" 2>&1 | tail -1
}

# dsh applies the home-level patch (~/.dsh/cordis.patch.yml) after every profile's: a web row of
# its own there replaces dsh-romeo's web search, whatever --web says. Prints that file, or nothing.
home_web_override() {
  local f=${1:-${DSH_HOME:-$HOME/.dsh}}/cordis.patch.yml
  [ -f "$f" ] && grep -q -E '^- id: web[[:space:]]*$' "$f" && printf '%s\n' "$f"
  return 0
}

ensure_web() {  # never fatal: without it dsh starts, without web search
  WEB_READY=''
  [ "$DSH_ROMEO_WEB" = on ] || return 0
  local out
  out=$(rustxng install) || true
  case $out in
    ok) WEB_READY=1 ;;
    installed) WEB_READY=1; say "web search installed on ROMEO ${D}(RustXNG 0.28.0, checksum verified)${N}" ;;
    *) say "web search ${Y}unavailable${N}: RustXNG on ROMEO: ${out:-no answer}"
       note "dsh starts without it; dsh-romeo --web off to stop trying" ;;
  esac
}

# Before a launch: this version's fiches and job clean-up on ROMEO, when they differ (an update
# without --setup). Fiches of your own (DSH_ROMEO_FICHE) are not touched.
sync_fiches() {
  local f src dst out changed=''
  for f in $FICHES prestart; do
    # shellcheck disable=SC2088  # expanded by the shell on ROMEO
    if [ "$f" = prestart ]; then src=$ROOT/share/prestart/sitecustomize.py dst='~/.dsh-romeo/prestart/sitecustomize.py'
    else src=$ROOT/share/fiches/$f.yaml dst="~/.romeollmtool/configs/$f.yaml"; fi
    [ -f "$src" ] || continue
    out=$(rsh_stdin "d=$dst; mkdir -p \$(dirname \$d) && sed \"s/__USER__/\$USER/g\" >\$d.new && if cmp -s \$d.new \$d; then rm -f \$d.new; else mv \$d.new \$d && echo changed; fi" <"$src" 2>&1) \
      || die "cannot write $(basename "$dst") on ROMEO: $(printf '%s\n' "$out" | tail -1)" "ssh $HOST 'df -h ~'   (ROMEO home full?)"
    [ "$out" != changed ] || changed="$changed $f"
  done
  [ -z "$changed" ] || say "updated on ROMEO ${D}(this version's settings):$changed${N}"
}

time_left_warning() {  # the agent's job ends soon: the session would stop in the middle of a task
  local left
  left=$(jobs_of_fiche "$FICHE" 2>/dev/null | awk '$2 == "RUNNING" { print $4 }' | while read -r t; do minutes_of "$t"; done | sort -n | tail -1) || true
  [ -n "$left" ] && [ "$left" -lt 30 ] || return 0
  say "${Y}model job ends in $left min${N} ${D}(DSH_ROMEO_TIME)${N}: dsh-romeo --launch submits a new one, which loads while you work"
}

prepare() {  # $1: jobs to launch first. Then the models answer, the tunnel is open, ROMEO_LLM_KEY is set.
  local launch=$1
  connect
  ensure_gateway
  [ "$launch" -eq 0 ] || sync_fiches
  read_fiches
  # The key before any job: a run that cannot go on submits nothing.
  ROMEO_LLM_KEY=$(rlt gateway show-key | tail -1 | tr -d '[:space:]') || true
  [ -n "$ROMEO_LLM_KEY" ] || die "cannot read the gateway key" "ssh $HOST $ROMEOLLMTOOL gateway show-key"
  [ "$launch" -eq 0 ] || launch_jobs "$launch"
  [ "$DSH_ROMEO_GATEWAY" = fast ] && ensure_fast_gateway
  open_tunnel
  if ! models_answer; then
    check_jobs "no model job on ROMEO" "dsh-romeo${SUB_FICHE:+ --models $DSH_ROMEO_MODELS} --launch"
    note "$LABEL takes ~$([ "$LABEL" = Kimi-K3.1-Pro ] && echo 12 || echo 10) min to load once its job runs"
    note "Ctrl-C stops waiting, not the job"
    wait_for_model
  fi
  say "$LABEL ${G}ready${N} ${D}($MODEL)${N}"
  note "gateway  $GATEWAY  (on ROMEO; its key: dsh-romeo --env)"
  note "local    http://127.0.0.1:$PORT/v1  (the tunnel to it, what dsh uses)"
  [ -z "$SUB_MODEL" ] || say "$SUB_LABEL ${G}ready${N} for the subagents ${D}($SUB_MODEL)${N}"
  time_left_warning
  if [ -n "$VOICE_MODEL" ]; then open_voice_tunnel; else voice_off; fi
  ensure_web
  [ -z "$WEB_READY" ] || say "web search ${G}ready${N} ${D}(RustXNG on the ROMEO login node, over this SSH connection)${N}"
  local over
  over=$(home_web_override)
  if [ -n "$WEB_READY$DSH_ROMEO_SEARXNG_URL" ] && [ -n "$over" ]; then
    say "${Y}your $over sets dsh's web search itself${N}: it wins over dsh-romeo's"
    note "remove its '- id: web' row (and the search plugin it inserts) to use dsh-romeo's"
  fi
}

# Voice input goes straight to the Whisper job: romeollmtool's gateway cannot relay audio uploads
# (multipart /v1/audio/transcriptions: its python-multipart is missing). A second forward of the same
# SSH connection, 127.0.0.1:$DSH_ROMEO_VOICE_PORT -> the job, and the job's own key in
# $VOICE_KEY_FILE, read by the plugin at each recording. A job still waiting for its GPU gets a
# watcher in the background that does the same once it runs: the microphone then works without
# restarting dsh.
VOICE_KEY_FILE=$CONFIG_DIR/whisper.key

open_voice_tunnel() {
  local jobs job
  jobs=$(jobs_of_fiche "$VOICE_FICHE") || true
  job=$(running_job <<<"$jobs")
  if [ -n "$job" ]; then
    voice_forward "$job" || return 0
    if curl_key "$(cat "$VOICE_KEY_FILE")" -sf -m 10 "http://127.0.0.1:$DSH_ROMEO_VOICE_PORT/v1/models" | grep -q "\"$VOICE_MODEL\""; then
      say "voice input ${G}ready${N} ${D}(Whisper on ROMEO, job $job)${N}"
    else
      say "voice input ${Y}loading${N} ${D}(Whisper job $job, a few minutes; the microphone works once it is up)${N}"
    fi
  elif [ -n "$jobs" ]; then
    stop_voice_watch
    voice_watch </dev/null >/dev/null 2>&1 &
    echo $! >"$CTL.voice-watch"
    disown 2>/dev/null || true
    say "voice input ${Y}waiting for its GPU${N} ${D}(the microphone works once the Whisper job runs)${N}"
  else
    say "voice input ${Y}unavailable${N}: no Whisper job"
    note "the next dsh-romeo --launch submits one, and a model job too"
  fi
}

voice_forward() {  # $1: a running Whisper job. Forward to it and write its key; 1 when it cannot.
  local ep target key
  ep=$(rlt endpoint "$1" --show-key 2>/dev/null) || true
  target=$(printf '%s\n' "$ep" | grep direct | grep -oE 'https?://[A-Za-z0-9.-]+:[0-9]+' | head -1)
  key=$(printf '%s\n' "$ep" | sed -n '/clé interne/,$p' | grep -oE '[A-Za-z0-9_-]{24,}' | tail -1)
  if [ -z "$target" ] || [ -z "$key" ]; then
    say "voice input ${Y}unavailable${N}: cannot read the endpoint of Whisper job $1"
    return 1
  fi
  target=${target#*://}
  forward "$DSH_ROMEO_VOICE_PORT" "$target" "$CTL.voice" \
    || { voice_refused; return 1; }
  (umask 077; printf '%s\n' "$key" >"$VOICE_KEY_FILE.tmp") && mv "$VOICE_KEY_FILE.tmp" "$VOICE_KEY_FILE"
}

stop_voice_watch() {  # the watcher of an earlier start, if it still runs
  local pid
  pid=$(cat "$CTL.voice-watch" 2>/dev/null || true)
  [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
  rm -f "$CTL.voice-watch"
}

voice_off() {  # --voice off: no forward to the Whisper job, no key left behind; its job is said
  stop_voice_watch
  [ -s "$CTL.voice" ] || [ -e "$VOICE_KEY_FILE" ] || return 0
  [ ! -s "$CTL.voice" ] || mux cancel -L "$DSH_ROMEO_VOICE_PORT:$(cat "$CTL.voice")" || true
  rm -f "$CTL.voice" "$VOICE_KEY_FILE"
  local jobs
  jobs=$(jobs_of_fiche "$FICHE_VOICE" | awk '{ print $1 }' | tr '\n' ' ')
  [ -z "$jobs" ] || say "${Y}Whisper job ${jobs% } still runs${N} (1 GPU): dsh-romeo --stop cancels it"
}

voice_refused() {  # the reason, as for the main tunnel: a busy port is only one of them
  local holder
  holder=$(port_holder "$DSH_ROMEO_VOICE_PORT")
  say "voice input ${Y}unavailable${N}: cannot forward 127.0.0.1:$DSH_ROMEO_VOICE_PORT"
  if [ -n "$holder" ]; then note "${holder% *} (pid ${holder#* }) listens on it: kill it, or set DSH_ROMEO_VOICE_PORT"
  else note "ssh refused it: ${FORWARD_ERROR:-no reason given}"; fi
}

voice_watch() {  # until the Whisper job runs (6 h at most), then voice_forward; ends with its job
  local _ jobs job
  for _ in $(seq 1 "${DSH_ROMEO_VOICE_WATCH_TRIES:-720}"); do
    sleep "${DSH_ROMEO_POLL:-30}"
    jobs=$(jobs_of_fiche "$VOICE_FICHE") || continue
    [ -n "$jobs" ] || return 0
    job=$(running_job <<<"$jobs")
    if [ -n "$job" ]; then voice_forward "$job"; return 0; fi
  done
}

remember() {  # $1 variable, $2 value, $3 file: set, check, and keep for the next runs
  printf -v "$1" %s "$2"
  resolve_models
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$2" >"$3"
}

main() {
  local launch=0 cmd=''
  # --models, --voice, --launch [N] and --serve, --env, --desktop in any order; then a command and its own
  # arguments (--run CMD ..., a dsh profile ...).
  while [ $# -gt 0 ]; do
    case $1 in
      --models)
        [ $# -ge 2 ] || die "--models takes deepseek, kimi or kimi+deepseek" "dsh-romeo --models kimi+deepseek --launch"
        remember DSH_ROMEO_MODELS "$2" "$MODELS_FILE"
        shift 2 ;;
      --voice)
        [ $# -ge 2 ] || die "--voice takes on or off" "dsh-romeo --voice on --launch"
        remember DSH_ROMEO_VOICE "$2" "$VOICE_FILE"
        shift 2 ;;
      --web)
        [ $# -ge 2 ] || die "--web takes on or off" "dsh-romeo --web on"
        remember DSH_ROMEO_WEB "$2" "$WEB_FILE"
        shift 2 ;;
      --launch)
        shift
        launch=1
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then launch=$1; shift; fi
        [ "$launch" -ge 1 ] && [ "$launch" -le 8 ] || die "--launch takes 1 to 8 jobs, not $launch" "dsh-romeo --launch 2" ;;
      --serve | --env | --desktop)
        [ -z "$cmd" ] || [ "$cmd" = "$1" ] || die "$cmd and $1 do not combine" "dsh-romeo $1"
        cmd=$1
        shift ;;
      *) break ;;
    esac
  done
  resolve_models
  if [ -n "$cmd" ]; then
    [ $# -eq 0 ] || die "$cmd takes no argument (got $1)" "dsh-romeo $cmd"
    preflight "$cmd"
    exec 3>&1 1>&2  # stdout is print_serve's and print_env's alone: eval "$(dsh-romeo --env)"
    prepare "$launch"
    case $cmd in
      --serve) print_serve >&3 ;;
      --env) print_env >&3 ;;
      --desktop) run_desktop ;;
    esac
    return
  fi
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -V|--version) cmd_version; exit 0 ;;
    --completion) cmd_completion "${2:-}"; exit 0 ;;
    --doctor)
      [ "$launch" -eq 0 ] || die "--launch and --doctor do not combine" "dsh-romeo --doctor"
      cmd_doctor
      exit 0 ;;
    --logs)
      [ "$launch" -eq 0 ] || die "--launch and --logs do not combine" "dsh-romeo --logs"
      cmd_logs "${2:-}"
      exit 0 ;;
    --status | --stop | --setup)
      [ "$launch" -eq 0 ] || die "--launch and $1 do not combine" "dsh-romeo $1"
      case $1 in --status) cmd_status ;; --stop) cmd_stop ;; --setup) cmd_setup ;; esac
      exit 0 ;;
    --run)
      shift
      [ $# -gt 0 ] || die "--run needs a command" "dsh-romeo --run opencode"
      preflight --run "$1"
      prepare "$launch"
      run_client "$@" ;;
    *) preflight "${1:-}"; prepare "$launch"; run_dsh "$@" ;;
  esac
}

main "$@"; exit  # on the same line: a script edited while it runs is not read further
