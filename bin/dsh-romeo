#!/usr/bin/env bash
# dsh-romeo: DeepSeek Harness (dsh) on your computer, DeepSeek-V4.1-Flash-1017 on ROMEO's GPUs.
#
#   dsh-romeo                     open the dsh Web UI (every dsh profile and argument passes through:
#   dsh-romeo headless "a task"     dsh-romeo web --port 3000, dsh-romeo headless "...")
#   dsh-romeo --launch [N]        submit N model jobs (default 1), wait for the model, then open dsh
#   dsh-romeo --desktop           the DeepSeek Harness desktop app (macOS) instead of the Web UI
#   dsh-romeo --run CMD [ARGS]    any other client instead of dsh: opencode, codex, claude, aider, python...
#   dsh-romeo --serve             only the model and the tunnel: an OpenAI-compatible endpoint for any tool
#   dsh-romeo --env               print the endpoint as shell variables: eval "$(dsh-romeo --env)"
#   dsh-romeo --status            gateway, model jobs, tunnel
#   dsh-romeo --stop              cancel the model jobs of dsh-romeo's fiche, close the tunnel
#   dsh-romeo --setup             copy the model fiche to ROMEO again (after an update)
#   dsh-romeo --version | --help
# --launch combines with the others: dsh-romeo --launch --run opencode.
#
# What it does: keeps the romeollmtool gateway running on the ROMEO login node, launches the
# model with romeollmtool when asked, opens one SSH connection that carries a tunnel
# 127.0.0.1:$DSH_ROMEO_PORT -> gateway, then runs dsh with an overlay (--patch) that adds a
# "romeo" provider and makes it the default model. Your own dsh profiles are not modified.
#
# Settings: ~/.config/dsh-romeo/config (written by install.sh). A variable set in the
# environment wins over the file.
set -euo pipefail

VERSION=0.1.0

# The repository this script lives in (it is usually reached through a symlink).
src=$0
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
ROOT=$(cd "$(dirname "$src")/.." && pwd)

CONFIG_DIR=${DSH_ROMEO_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dsh-romeo}
# shellcheck source=/dev/null
[ -f "$CONFIG_DIR/config" ] && . "$CONFIG_DIR/config"
: "${ROMEO_SSH_HOST:=romeo}"                             # ssh alias of a ROMEO login node
: "${ROMEO_PROJECT:=}"                                   # Slurm project code charged for the model jobs
: "${DSH_ROMEO_FICHE:=dsh-deepseek-v4.1-flash-1017-1m}"       # romeollmtool fiche of the model
: "${DSH_ROMEO_TIME:=08:00:00}"                          # model job duration (max 24:00:00)
: "${DSH_ROMEO_PORT:=11318}"                             # local end of the tunnel
: "${DSH_ROMEO_EFFORT:=max}"                             # default reasoning effort: none, low, high, max
: "${DSH_ROMEO_SEARXNG_URL:=}"                           # SearXNG for web search, e.g. http://127.0.0.1:8888
: "${DSH_ROMEO_GATEWAY:=standard}"                       # standard, or fast: no 100-stream cap, affinity
: "${DSH_ROMEO_FAST_PORT:=11320}"                        # port of the fast gateway on the login node
: "${DSH_ROMEO_FAST_PROCS:=4}"                           # its processes
: "${ROMEOLLMTOOL:=/apps/romeotools/romeollmtool/romeollmtool}"

HOST=$ROMEO_SSH_HOST
FICHE=$DSH_ROMEO_FICHE
PORT=$DSH_ROMEO_PORT
# Control socket of the shared SSH connection (Unix socket paths are limited to ~100 bytes).
CTL=${DSH_ROMEO_SOCKET:-$HOME/.ssh/dsh-romeo-$HOST.sock}
OVERLAY=$CONFIG_DIR/dsh.patch.yml

# Messages go to stderr: stdout is left to what a command prints (--env, --serve) and to the client.
if [ -t 2 ]; then B=$'\e[1m' D=$'\e[2m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B='' D='' G='' Y='' R='' N=''; fi
say() { printf '%s\n' "${B}dsh-romeo${N} $*" >&2; }
note() { printf '%s\n' "          ${D}$*${N}" >&2; }
die() { printf '%s\n' "${R}dsh-romeo:${N} $*" >&2; exit 1; }

usage() { sed -n '2,15p' "$src" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- SSH

# OpenSSH 10 warns about every server without post-quantum key exchange: noise here.
quiet() { grep -v -E 'post-quantum|store now, decrypt later|openssh.com/pq|^\*\* ' >&2 || true; }

connect() {  # one connection, reused by every command and carrying the tunnel
  mkdir -p "$(dirname "$CTL")"
  ssh -S "$CTL" -O check "$HOST" 2>/dev/null && return 0
  rm -f "$CTL"
  ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30 -o ServerAliveCountMax=4 \
      -o ExitOnForwardFailure=yes -M -S "$CTL" -f -N "$HOST" 2> >(quiet) \
    || die "cannot connect to '$HOST' over SSH. Check that 'ssh $HOST' works without a password (README: Install)."
}

rsh() { ssh -n -S "$CTL" -o BatchMode=yes "$HOST" "$@" 2> >(quiet); }      # stdin stays yours
rsh_stdin() { ssh -S "$CTL" -o BatchMode=yes "$HOST" "$@" 2> >(quiet); }   # stdin goes to ROMEO

disconnect() { ssh -S "$CTL" -O exit "$HOST" 2>/dev/null || true; }

# ---------------------------------------------------------------- ROMEO

rlt() { rsh "$ROMEOLLMTOOL $*"; }

gateway_url() {  # the gateway's URL, empty when it is not running
  rlt gateway status 2>/dev/null | grep -oE 'https?://[^ ]+:[0-9]+/v1' | head -1 || true
}

ensure_gateway() {
  local url
  url=$(gateway_url)
  if [ -z "$url" ]; then
    say "starting the romeollmtool gateway on ROMEO"
    rlt gateway start --hours 24 >/dev/null || die "romeollmtool gateway start failed (try: ssh $HOST $ROMEOLLMTOOL doctor)"
    url=$(gateway_url)
    [ -n "$url" ] || die "the gateway did not start (ssh $HOST $ROMEOLLMTOOL gateway logs)"
  else
    # Its automatic stop would also cancel the model jobs: push it 24 h away.
    rlt gateway extend --hours 24 >/dev/null 2>&1 || true
  fi
  GATEWAY=$url
}

# The fiche as romeollmtool will launch it: served model name, context and output limits.
read_fiche() {
  local show
  show=$(rlt catalog show "$FICHE" 2>/dev/null) || true
  printf '%s\n' "$show" | grep -q '^vllm:' \
    || die "fiche '$FICHE' not found on ROMEO. Run: dsh-romeo --setup"
  eval "$(printf '%s\n' "$show" | awk '
    /^vllm:/ { v = 1; next }
    /^generation:/ { g = 1; next }
    /^[^ -]/ { v = 0; g = 0 }
    v && /^  served_model_name:/ { served = $2 }
    v && /^  model:/ { model = $2 }
    v && /--max-model-len/ { getline; gsub(/[^0-9]/, ""); ctx = $0 }
    g && /^  max_tokens:/ { out = $2 }
    END {
      name = served != "" ? served : model
      gsub(/["\047]/, "", name); gsub(/["\047]/, "", out)
      printf "MODEL=%s CONTEXT=%s MAX_TOKENS=%s\n", name, ctx + 0 ? ctx : 262144, out + 0 ? out : 65536
    }')"
  [ -n "$MODEL" ] || die "cannot read the served model name of fiche '$FICHE'"
}

jobs_of_fiche() {  # "jobid state elapsed left reason" for each model job of the fiche
  rsh "squeue -u \$USER -h -n romeollmtool-$FICHE -o '%i %T %M %L %r'" || true
}

launch_jobs() {
  local n=$1 out
  [ -n "$ROMEO_PROJECT" ] || die "no project code: set ROMEO_PROJECT in $CONFIG_DIR/config (rerun install.sh)"
  for _ in $(seq 1 "$n"); do
    out=$(rlt launch "$FICHE" --project-code "$ROMEO_PROJECT" --time "$DSH_ROMEO_TIME" --no-wait 2>&1) \
      || { printf '%s\n' "$out" >&2; die "romeollmtool launch failed"; }
    say "model job $(printf '%s\n' "$out" | grep -oE '[0-9]{5,}' | head -1) submitted ($FICHE, $DSH_ROMEO_TIME)"
  done
}

# ---------------------------------------------------------------- tunnel and model

open_tunnel() {  # 127.0.0.1:$PORT -> the gateway, kept when it already leads there
  local target=${GATEWAY#*://} previous
  target=${target%/v1}
  previous=$(cat "$CTL.target" 2>/dev/null || true)
  [ "$previous" = "$target" ] && probe_models >/dev/null 2>&1 && return 0
  [ -n "$previous" ] && ssh -S "$CTL" -O cancel -L "$PORT:$previous" "$HOST" 2>/dev/null
  ssh -S "$CTL" -O cancel -L "$PORT:$target" "$HOST" 2>/dev/null || true
  ssh -S "$CTL" -O forward -L "$PORT:$target" "$HOST" 2>/dev/null \
    || die "cannot forward 127.0.0.1:$PORT (another program uses it? set DSH_ROMEO_PORT)"
  printf '%s\n' "$target" >"$CTL.target"
}

# DSH_ROMEO_GATEWAY=fast: a second gateway on the login node, patched (share/gateway): no
# 100-stream cap, session affinity across model jobs, longer timeouts. Falls back to
# romeollmtool's gateway when it cannot start.
# shellcheck disable=SC2088  # expanded by the shell on ROMEO
FAST_DIR='~/.dsh-romeo/gateway'
FAST_PATTERN="[r]omeollmtool.gateway.server --host 0.0.0.0 --port $DSH_ROMEO_FAST_PORT"

ensure_fast_gateway() {
  local out
  rsh "mkdir -p $FAST_DIR"
  rsh_stdin "cat > $FAST_DIR/sitecustomize.py" <"$ROOT/share/gateway/sitecustomize.py"
  rsh_stdin "cat > $FAST_DIR/start.sh && chmod +x $FAST_DIR/start.sh" <"$ROOT/share/gateway/start.sh"
  if out=$(rsh "ROMEOLLMTOOL=$ROMEOLLMTOOL $FAST_DIR/start.sh $DSH_ROMEO_FAST_PORT $DSH_ROMEO_FAST_PROCS 2>&1"); then
    GATEWAY=http://localhost:$DSH_ROMEO_FAST_PORT/v1
    say "fast gateway ${G}running${N} ${D}(port $DSH_ROMEO_FAST_PORT, $DSH_ROMEO_FAST_PROCS processes)${N}"
  else
    say "${Y}fast gateway unavailable${N}, romeollmtool's gateway is used: $(printf '%s' "$out" | tail -1)"
  fi
}

probe_models() {  # the gateway's model list, through the tunnel
  curl -sf -m 10 "http://127.0.0.1:$PORT/v1/models" -H "Authorization: Bearer $ROMEO_LLM_KEY"
}

model_answers() {  # a one-token completion: the model is loaded and serving
  local code
  code=$(curl -s -o /dev/null -m 60 -w '%{http_code}' "http://127.0.0.1:$PORT/v1/chat/completions" \
    -H "Authorization: Bearer $ROMEO_LLM_KEY" -H 'Content-Type: application/json' \
    -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1,\"reasoning_effort\":\"none\"}" || true)
  [ "$code" = 200 ]
}

wait_for_model() {
  local start jobs line shown='' width
  start=$(date +%s)
  while ! model_answers; do
    jobs=$(jobs_of_fiche)
    [ -n "$jobs" ] || die "no model job left (it ended or failed): ssh $HOST $ROMEOLLMTOOL logs"
    line=$(waiting_line "$jobs" $(( $(date +%s) - start )))
    if [ -t 2 ]; then  # one line, rewritten in place: never wider than the terminal
      width=$(tput cols 2>/dev/null || echo 100)
      line=${line:0:$((width - 11))}
      printf '\r\033[K%s %s' "${B}dsh-romeo${N}" "${D}$line${N}" >&2
    elif [ "${line%% · [0-9]*}" != "$shown" ]; then
      say "$line"
      shown=${line%% · [0-9]*}
    fi
    sleep "${DSH_ROMEO_POLL:-15}"
  done
  if [ -t 2 ]; then printf '\r\033[K' >&2; fi
}

waiting_line() {  # $1: the jobs, $2: seconds waited
  local what="loading the model on ROMEO"
  grep -q ' RUNNING ' <<<"$1" || what="waiting for GPUs on ROMEO"
  printf '%s · %s · %d min %02d s · Ctrl-C stops waiting, not the job' "$what" "$(summary "$1")" $(($2 / 60)) $(($2 % 60))
}

summary() {  # one line for the jobs: "job 123 running 4:10" or "job 123 pending (Resources)"
  printf '%s\n' "$1" | awk '{
    s = tolower($2); line = "job " $1 " " s
    if (s == "running") line = line " " $3; else if ($5 != "None") line = line " (" $5 ")"
    printf "%s%s", (NR > 1 ? ", " : ""), line }'
}

# ---------------------------------------------------------------- dsh

write_overlay() {
  local effort=$DSH_ROMEO_EFFORT
  # dsh uses "off" internally; reasoningEfforts below maps it to API "none".
  [ "$effort" != none ] || effort=off
  mkdir -p "$CONFIG_DIR"
  {
    cat <<YAML
# Written by dsh-romeo at every start: edit $CONFIG_DIR/config instead.
# Adds the "romeo" provider (DeepSeek-V4.1-Flash-1017 on ROMEO, through the SSH tunnel) and makes it
# the default model. The API key comes from the ROMEO_LLM_KEY environment variable.
- id: llm-pi-ai
  config:
    providers:
      romeo:
        displayName: ROMEO
        apiKeyEnv: ROMEO_LLM_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:$PORT/v1
        compat:
          supportsDeveloperRole: false
          supportsStore: false
          maxTokensField: max_tokens
        reasoning: $effort
        streamIdleTimeoutMs: 600000
        models:
          - id: $MODEL
            name: DeepSeek-V4.1-Flash-1017 (ROMEO)
            contextWindow: $CONTEXT
            maxTokens: $MAX_TOKENS
            input: [ text ]
            reasoningEfforts: { off: none, low: low, high: high, max: max }
- id: agent-default-model
  config:
    provider: romeo
    model: $MODEL
    reasoningEffort: $effort
YAML
    if [ -n "$DSH_ROMEO_SEARXNG_URL" ]; then
      cat <<YAML
# Web search through SearXNG (DSH_ROMEO_SEARXNG_URL).
- id: web
  config:
    searchProvider: dsh-romeo-searxng
    fetchProvider: http
- id: tool-web
  disabled: false
- insert:
    - id: dsh-romeo-searxng
      name: $ROOT/share/web-search-searxng.mjs
      config:
        providerId: dsh-romeo-searxng
        baseURL: "$DSH_ROMEO_SEARXNG_URL"
YAML
    fi
  } >"$OVERLAY.tmp"
  mv "$OVERLAY.tmp" "$OVERLAY"
}

run_dsh() {
  command -v "${DSH_ROMEO_DSH:-dsh}" >/dev/null || die "dsh is not installed: npm install -g @deepseek-ai/dsh"
  write_overlay
  local profile=${1:-web}
  [ $# -gt 0 ] && shift
  export ROMEO_LLM_KEY
  exec "${DSH_ROMEO_DSH:-dsh}" "$profile" --patch "$OVERLAY" "$@"
}

# The DeepSeek Harness desktop app (macOS) runs dsh on its own "desktop" profile and takes no
# --patch: the overlay goes into that profile's cordis.patch.yml. A patch of your own there is
# kept once as cordis.patch.yml.before-dsh-romeo.
DESKTOP_APP=${DSH_ROMEO_DESKTOP_APP:-DeepSeek Harness}
run_desktop() {
  [ "$(uname)" = Darwin ] || die "--desktop: the DeepSeek Harness desktop app is for macOS"
  open -Ra "$DESKTOP_APP" 2>/dev/null || die "the $DESKTOP_APP app is not installed (https://github.com/deepseek-ai/deepseek-harness/releases)"
  write_overlay
  local dir=$HOME/.dsh/profiles/desktop
  local patch=$dir/cordis.patch.yml
  mkdir -p "$dir"
  if [ -f "$patch" ] && ! grep -q '^# Written by dsh-romeo' "$patch" && grep -q -v -E '^[[:space:]]*(#|\[\][[:space:]]*$|$)' "$patch"; then
    [ -e "$patch.before-dsh-romeo" ] || cp "$patch" "$patch.before-dsh-romeo"
    note "your desktop patch was kept as $patch.before-dsh-romeo"
  fi
  cp "$OVERLAY" "$patch"
  # The app reads its environment at start only: a running copy is quit first (its sessions are kept).
  if pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/"; then
    say "restarting $DESKTOP_APP so it gets the ROMEO key"
    osascript -e "quit app \"$DESKTOP_APP\"" >/dev/null 2>&1 || true
    local _
    for _ in $(seq 1 30); do pgrep -qf "/$DESKTOP_APP.app/Contents/MacOS/" || break; sleep 1; done
  fi
  say "opening $DESKTOP_APP ${D}(the tunnel stays open until dsh-romeo --stop)${N}"
  open -a "$DESKTOP_APP" --env "ROMEO_LLM_KEY=$ROMEO_LLM_KEY"
}

# ---------------------------------------------------------------- other clients

# The endpoint in the variables that OpenAI- and Anthropic-compatible clients read.
export_endpoint() {
  BASE_URL=http://127.0.0.1:$PORT/v1
  export ROMEO_LLM_KEY DSH_ROMEO_MODEL=$MODEL DSH_ROMEO_BASE_URL=$BASE_URL
  export OPENAI_BASE_URL=$BASE_URL OPENAI_API_BASE=$BASE_URL OPENAI_API_KEY=$ROMEO_LLM_KEY
  export ANTHROPIC_BASE_URL=http://127.0.0.1:$PORT ANTHROPIC_AUTH_TOKEN=$ROMEO_LLM_KEY ANTHROPIC_MODEL=$MODEL
  export ANTHROPIC_DEFAULT_OPUS_MODEL=$MODEL ANTHROPIC_DEFAULT_SONNET_MODEL=$MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL=$MODEL
  export ANTHROPIC_SMALL_FAST_MODEL=$MODEL CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  export AIDER_MODEL=openai/$MODEL
  write_opencode_config
  export OPENCODE_CONFIG=$CONFIG_DIR/opencode.json
}

write_opencode_config() {  # a "romeo" provider for opencode; the key stays in the environment
  mkdir -p "$CONFIG_DIR"
  cat >"$CONFIG_DIR/opencode.json.tmp" <<JSON
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "romeo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ROMEO",
      "options": { "baseURL": "http://127.0.0.1:$PORT/v1", "apiKey": "{env:ROMEO_LLM_KEY}" },
      "models": {
        "$MODEL": {
          "name": "DeepSeek-V4.1-Flash-1017 (ROMEO)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": $CONTEXT, "output": $MAX_TOKENS }
        }
      }
    }
  },
  "model": "romeo/$MODEL"
}
JSON
  mv "$CONFIG_DIR/opencode.json.tmp" "$CONFIG_DIR/opencode.json"
}

run_client() {  # exec a client with the endpoint in its environment (and in its flags for codex)
  command -v "$1" >/dev/null || die "$1: command not found"
  export_endpoint
  case $(basename "$1") in
    codex)  # Codex takes custom providers from its config only, and speaks the Responses API to them
      local cmd=$1
      shift
      exec "$cmd" -c model_provider=romeo -c model="$MODEL" \
        -c "model_providers.romeo={ name = \"ROMEO\", base_url = \"$BASE_URL\", env_key = \"ROMEO_LLM_KEY\", wire_api = \"responses\" }" "$@" ;;
  esac
  exec "$@"
}

print_env() {
  export_endpoint
  local v
  for v in ROMEO_LLM_KEY DSH_ROMEO_MODEL DSH_ROMEO_BASE_URL OPENAI_BASE_URL OPENAI_API_BASE OPENAI_API_KEY \
           ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL \
           ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_SMALL_FAST_MODEL \
           CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC AIDER_MODEL OPENCODE_CONFIG; do
    printf 'export %s=%q\n' "$v" "${!v}"
  done
}

print_serve() {
  cat <<TEXT
DeepSeek-V4.1-Flash-1017 on ROMEO, an OpenAI-compatible endpoint for any client:
  base URL   http://127.0.0.1:$PORT/v1
  model      $MODEL
  API key    the gateway's: eval "\$(dsh-romeo --env)" puts it in OPENAI_API_KEY and ROMEO_LLM_KEY
The tunnel stays open until dsh-romeo --stop (after this computer sleeps, run dsh-romeo --serve again).
TEXT
}

# ---------------------------------------------------------------- commands

cmd_status() {
  connect
  local url jobs
  url=$(gateway_url)
  if [ -n "$url" ]; then say "gateway ${G}running${N} $url"; else say "gateway ${Y}stopped${N}"; fi
  if [ "$DSH_ROMEO_GATEWAY" = fast ]; then
    local procs
    procs=$(rsh "pgrep -u \$USER -f '^[^ ]*python[^ ]* -m $FAST_PATTERN' | wc -l" | tr -d '[:space:]')  # not the timeout wrappers
    if [ "${procs:-0}" -gt 0 ]; then say "fast gateway ${G}running${N} ${D}(port $DSH_ROMEO_FAST_PORT, $procs processes)${N}"
    else say "fast gateway ${Y}stopped${N}"; fi
  fi
  jobs=$(jobs_of_fiche)
  if [ -n "$jobs" ]; then
    printf '%s\n' "$jobs" | while read -r id st el left _; do
      say "model job $id $(printf '%s' "$st" | tr 'A-Z' 'a-z') ${D}elapsed $el, left $left${N}"
    done
  else
    say "no model job of $FICHE ${D}(dsh-romeo --launch)${N}"
  fi
  if curl -s -m 3 -o /dev/null "http://127.0.0.1:$PORT/v1/models"; then
    say "tunnel ${G}open${N} 127.0.0.1:$PORT"
  else
    say "tunnel closed"
  fi
}

cmd_stop() {
  connect
  local jobs id
  jobs=$(jobs_of_fiche)
  if [ -z "$jobs" ]; then
    say "no model job of $FICHE"
  else
    for id in $(printf '%s\n' "$jobs" | awk '{print $1}'); do
      rlt stop "$id" </dev/null >/dev/null 2>&1 || rsh "scancel $id"
      say "model job $id stopped"
    done
  fi
  if [ "$DSH_ROMEO_GATEWAY" = fast ]; then
    rsh "pkill -u \$USER -f '$FAST_PATTERN'" && say "fast gateway stopped"
  fi
  disconnect
  rm -f "$CTL.target"
  say "tunnel closed ${D}(romeollmtool's gateway keeps running; it stops by itself)${N}"
}

cmd_setup() {
  connect
  rsh "mkdir -p ~/.romeollmtool/configs"
  for f in "$ROOT"/share/fiches/*.yaml; do
    rsh_stdin "cat > ~/.romeollmtool/configs/$(basename "$f")" <"$f"
    say "fiche $(basename "$f" .yaml) installed in ~/.romeollmtool/configs on ROMEO"
  done
  rlt version >/dev/null 2>&1 || die "romeollmtool not found at $ROMEOLLMTOOL on ROMEO"
}

prepare() {  # $1: jobs to launch first. Then the model answers, the tunnel is open, ROMEO_LLM_KEY is set.
  local launch=$1 jobs
  connect
  ensure_gateway
  read_fiche
  jobs=$(jobs_of_fiche)
  if [ "$launch" -gt 0 ]; then
    launch_jobs "$launch"
    jobs=$(jobs_of_fiche)
  fi
  ROMEO_LLM_KEY=$(rlt gateway show-key | tr -d '[:space:]')
  [ -n "$ROMEO_LLM_KEY" ] || die "cannot read the gateway key"
  [ "$DSH_ROMEO_GATEWAY" = fast ] && ensure_fast_gateway
  open_tunnel
  if ! model_answers; then
    [ -n "$jobs" ] || die "no $FICHE model job on ROMEO. Start one with: dsh-romeo --launch"
    note "the model loads in about 10 min once the job runs; the queue can add more"
    wait_for_model
  fi
  say "DeepSeek-V4.1-Flash-1017 ${G}ready${N} ${D}($MODEL, http://127.0.0.1:$PORT/v1)${N}"
}

main() {
  local launch=0
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "dsh-romeo $VERSION"; exit 0 ;;
    --status) cmd_status; exit 0 ;;
    --stop) cmd_stop; exit 0 ;;
    --setup) cmd_setup; exit 0 ;;
    --launch)
      shift
      launch=1
      if [[ "${1:-}" =~ ^[0-9]+$ ]]; then launch=$1; shift; fi
      [ "$launch" -ge 1 ] && [ "$launch" -le 8 ] || die "--launch takes 1 to 8 jobs"
      ;;
  esac
  case "${1:-}" in
    --serve) prepare "$launch"; print_serve ;;
    --env) prepare "$launch"; print_env ;;
    --desktop) prepare "$launch"; run_desktop ;;
    --run)
      shift
      [ $# -gt 0 ] || die "--run needs a command, e.g. dsh-romeo --run opencode"
      prepare "$launch"
      run_client "$@" ;;
    *) prepare "$launch"; run_dsh "$@" ;;
  esac
}

main "$@"; exit  # on the same line: a script edited while it runs is not read further
