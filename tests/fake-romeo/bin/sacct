#!/usr/bin/env bash
# Fake sacct for tests/run.sh: prints $FAKE_ROMEO_STATE/sacct (lines "JobID|State|End|NodeList|ExitCode"
# preceded by the job name and a space), only those whose name is given with --name=.
name=''
for a in "$@"; do case $a in --name=*) name=${a#--name=} ;; esac; done
[ -f "$FAKE_ROMEO_STATE/sacct" ] || exit 0
awk -v n="$name" '$1 == n { sub(/^[^ ]+ /, ""); print }' "$FAKE_ROMEO_STATE/sacct"
